<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/cat_sleep">
        <Preference
            android:key="sleep_screen"
            android:title="@string/sleep_title"
            android:summary="@string/sleep_summary"
            android:fragment="org.lineageos.hibreak.parts.SleepScreenFragment" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_frontlight">
        <SwitchPreferenceCompat
            android:key="frontlight_enabled"
            android:title="@string/frontlight_enabled"
            android:summary="@string/frontlight_enabled_summary"
            android:defaultValue="true" />
        <SeekBarPreference
            android:key="frontlight_warmth"
            android:title="@string/frontlight_warmth"
            android:max="100"
            android:defaultValue="70"
            android:persistent="false"
            app:showSeekBarValue="true"
            app:updatesContinuously="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_text">
        <SwitchPreferenceCompat
            android:key="text_bold"
            android:title="@string/text_bold"
            android:summary="@string/text_bold_summary"
            android:persistent="false" />
        <SwitchPreferenceCompat
            android:key="no_animations"
            android:title="@string/no_animations"
            android:summary="@string/no_animations_summary"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_eink">
        <ListPreference
            android:key="eink_profile"
            android:title="@string/eink_profile"
            android:entries="@array/profile_entries"
            android:entryValues="@array/profile_values"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true" />
        <Preference
            android:key="eink_app_profiles"
            android:title="@string/eink_app_profiles"
            android:summary="@string/eink_app_profiles_summary"
            android:fragment="org.lineageos.hibreak.parts.AppModesFragment" />
        <Preference
            android:key="eink_refresh_now"
            android:title="@string/eink_refresh_now"
            android:summary="@string/eink_refresh_now_summary" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/cat_keys">
        <ListPreference
            android:key="key_f1"
            android:title="@string/key_f1"
            android:entries="@array/key_action_entries"
            android:entryValues="@array/key_action_values"
            android:defaultValue="eink_refresh" />
        <ListPreference
            android:key="key_f2"
            android:title="@string/key_f2"
            android:entries="@array/key_action_entries"
            android:entryValues="@array/key_action_values"
            android:defaultValue="eink_mode" />
    </PreferenceCategory>
</PreferenceScreen>
