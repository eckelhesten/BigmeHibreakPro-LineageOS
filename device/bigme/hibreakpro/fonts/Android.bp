// Noto Sans (variable, upright and italic), the system font on this e-ink device.
// Unmodified files from the Google Fonts repository
// (github.com/google/fonts, ofl/notosans: NotoSans[wdth,wght].ttf and
// NotoSans-Italic[wdth,wght].ttf), SIL Open Font License 1.1 (OFL.txt).
//
// Installed to /system/fonts for `sans-serif` (font_fallback.xml, fonts.xml) and
// symlinked into /product/fonts for LineageOS's font customization (Settings and
// SystemUI families) without duplicating the TTFs.

license {
    name: "device_bigme_hibreakpro_fonts_license",
    license_kinds: ["SPDX-license-identifier-OFL"],
    license_text: ["OFL.txt"],
}

prebuilt_font {
    name: "NotoSans-VF.ttf",
    src: "NotoSans-VF.ttf",
    licenses: ["device_bigme_hibreakpro_fonts_license"],
}

prebuilt_font {
    name: "NotoSans-Italic-VF.ttf",
    src: "NotoSans-Italic-VF.ttf",
    licenses: ["device_bigme_hibreakpro_fonts_license"],
}

install_symlink {
    name: "NotoSans-VF.ttf.product",
    product_specific: true,
    installed_location: "fonts/NotoSans-VF.ttf",
    symlink_target: "/system/fonts/NotoSans-VF.ttf",
}

install_symlink {
    name: "NotoSans-Italic-VF.ttf.product",
    product_specific: true,
    installed_location: "fonts/NotoSans-Italic-VF.ttf",
    symlink_target: "/system/fonts/NotoSans-Italic-VF.ttf",
}
