<?xml version="1.0" encoding="utf-8"?>
<!-- E-ink: the mode labels sit on the black camera bar, and the selected one (disabled state) on a
     highlight that the two-tone palette makes white. Stock uses dark grey and white, which leaves
     the unselected modes faint and the selected one invisible. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@android:color/white" android:state_enabled="true" />
    <item android:color="@android:color/black" android:state_enabled="false" />
</selector>
