+package com.android.internal.policy;
+
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Outline;
+import android.graphics.Paint;
+import android.graphics.Rect;
+import android.graphics.drawable.Drawable;
+import android.os.SystemProperties;
+import android.util.TypedValue;
+import android.view.View;
+
+/**
+ * Outlines for floating windows on e-ink panels (debug.eink.windows=1).
+ *
+ * A dialog or popup normally stands out through the dim layer behind it and its shadow. An e-ink
+ * panel shows both as dithered grey, so the window manager leaves the dim out there, and the
+ * window draws a solid line around its background instead: black in light mode, white in dark
+ * mode. The line follows the outline of the view's background drawable; a view without a visible
+ * background gets none.
+ *
+ * @hide
+ */
+public final class EinkWindowOutline {
+
+    /** Read once per process. */
+    public static final boolean ENABLED = SystemProperties.getBoolean("debug.eink.windows", false);
+
+    private static final float WIDTH_DP = 2f;
+
+    private static final ThreadLocal<Outline> sOutline = ThreadLocal.withInitial(Outline::new);
+    private static final ThreadLocal<Paint> sPaint = ThreadLocal.withInitial(() -> {
+        final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        paint.setStyle(Paint.Style.STROKE);
+        return paint;
+    });
+
+    private EinkWindowOutline() {}
+
+    /** Draws the outline of {@code view}'s background on top of what the view has drawn. */
+    public static void draw(View view, Canvas canvas) {
+        if (!ENABLED) return;
+        final Drawable background = view.getBackground();
+        if (background == null) return;
+
+        final Outline outline = sOutline.get();
+        outline.setEmpty();
+        outline.setAlpha(1f);
+        background.getOutline(outline);
+        if (outline.isEmpty() || outline.getAlpha() <= 0f) return;
+
+        final float width = TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, WIDTH_DP,
+                view.getResources().getDisplayMetrics());
+        final Paint paint = sPaint.get();
+        paint.setStrokeWidth(width);
+        paint.setColor(view.getResources().getConfiguration().isNightModeActive()
+                ? Color.WHITE : Color.BLACK);
+
+        if (outline.mMode == Outline.MODE_ROUND_RECT) {
+            // Keep the whole line inside the background's edge.
+            final float half = width / 2f;
+            final Rect rect = outline.mRect;
+            final float radius = Math.max(outline.mRadius - half, 0f);
+            canvas.drawRoundRect(rect.left + half, rect.top + half, rect.right - half,
+                    rect.bottom - half, radius, radius, paint);
+        } else if (outline.mMode == Outline.MODE_PATH && outline.mPath != null) {
+            canvas.drawPath(outline.mPath, paint);
+        }
+    }
+}
