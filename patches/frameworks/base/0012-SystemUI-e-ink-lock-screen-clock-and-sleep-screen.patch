+    /**
+     * E-ink sleep screen: the icons sit on the lock wallpaper, so black on a light one and white
+     * on a dark one (its dark-text hint), as the keyguard status bar. Null when not e-ink.
+     */
+    private fun einkAodIconColor(context: android.content.Context): Int? {
+        if (!android.os.SystemProperties.getBoolean("debug.sysui.eink_palette", false)) return null
+        val wm = context.getSystemService(android.app.WallpaperManager::class.java) ?: return null
+        val colors =
+            wm.getWallpaperColors(android.app.WallpaperManager.FLAG_LOCK)
+                ?: wm.getWallpaperColors(android.app.WallpaperManager.FLAG_SYSTEM)
+                ?: return null
+        val darkText =
+            (colors.colorHints and android.app.WallpaperColors.HINT_SUPPORTS_DARK_TEXT) != 0
+        return if (darkText) Color.BLACK else Color.WHITE
+    }
