+    private static final boolean EINK_SLEEP =
+            SystemProperties.getBoolean("debug.sf.eink_motion", false);
+
+    private static void setEinkAsleep(int displayGroupId, boolean asleep) {
+        if (!EINK_SLEEP || displayGroupId != Display.DEFAULT_DISPLAY_GROUP) return;
+        try {
+            SystemProperties.set("vendor.xrz.hibreak_sleep", asleep ? "1" : "0");
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Could not set vendor.xrz.hibreak_sleep", e);
+        }
+    }
+
