From f3444dc04b7dc77de8c36a03b6b3be00fd7f545f Mon Sep 17 00:00:00 2001
From: hibreak <hibreak@localhost>
Date: Tue, 17 Nov 2026 02:53:07 +0000
Subject: [PATCH 15/16] e-ink: no ripples, no elevation shadows, mid-grey text
 left alone

For panels that show only black and white:
- debug.eink.no_ripple=1: RippleDrawable draws its content only. A ripple
  is a dither pattern that flickers through several refreshes per touch.
- debug.hwui.eink_no_shadow=1: no elevation shadows, which are bands of
  dither noise around cards, buttons and dialogs.
- debug.hwui.eink_text: mid-grey text (L 55-85) keeps its colour instead of
  snapping to white, which made grey hints invisible on white. Whether it
  should be black or white depends on the background, which SurfaceFlinger's
  e-ink pass decides from the composed picture.

Change-Id: I470d098806f92a804fe0b65aa3001edde252ef4e
---
 .../java/android/graphics/drawable/RippleDrawable.java   | 9 +++++++++
 libs/hwui/Properties.cpp                                 | 2 ++
 libs/hwui/Properties.h                                   | 3 +++
 libs/hwui/hwui/DrawTextFunctor.h                         | 4 ++++
 libs/hwui/pipeline/skia/ReorderBarrierDrawables.cpp      | 2 ++
 5 files changed, 20 insertions(+)

diff --git a/graphics/java/android/graphics/drawable/RippleDrawable.java b/graphics/java/android/graphics/drawable/RippleDrawable.java
index 641a2ae7b..370a7448c 100644
--- a/graphics/java/android/graphics/drawable/RippleDrawable.java
+++ b/graphics/java/android/graphics/drawable/RippleDrawable.java
@@ -337,12 +337,21 @@ public class RippleDrawable extends LayerDrawable {
                 windowFocused = true;
             }
         }
+        // E-ink: no ripple and no hover or focus wash, the content is drawn as it is.
+        if (EINK_NO_RIPPLE) return changed;
         setRippleActive(enabled && pressed);
         setBackgroundActive(hovered, focused, pressed, windowFocused);
 
         return changed;
     }
 
+    /**
+     * E-ink panels (debug.eink.no_ripple=1): on a panel that shows black and white only, a
+     * ripple is a dither pattern that flickers through several refreshes for each touch.
+     */
+    private static final boolean EINK_NO_RIPPLE =
+            android.os.SystemProperties.getBoolean("debug.eink.no_ripple", false);
+
     private void setRippleActive(boolean active) {
         if (mRippleActive != active) {
             mRippleActive = active;
