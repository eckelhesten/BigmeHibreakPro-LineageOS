+++ b/services/core/java/com/android/server/wm/DisplayPolicy.java
@@ -169,7 +169,14 @@ public class DisplayPolicy {
     private static final String EINK_TOUCH_PROPERTY = "vendor.xrz.hibreak_touch";
 
     private void setEinkTouch(boolean down) {
-        if (!EINK_MOTION || mDisplayContent.getDisplayId() != android.view.Display.DEFAULT_DISPLAY) {
+        if (mDisplayContent.getDisplayId() != android.view.Display.DEFAULT_DISPLAY) {
+            return;
+        }
+        // CPU boost for the work a touch starts (PowerManagerService, debug.eink.touch_boost_ms).
+        if (mService.mPowerManagerInternal != null) {
+            mService.mPowerManagerInternal.setTouchBoost(down);
+        }
+        if (!EINK_MOTION) {
             return;
         }
         try {
