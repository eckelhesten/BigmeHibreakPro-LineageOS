         if (mWeatherCity != null) {
             // Berlin · [icon] 5°C · Cloudy; the city gives way first.
-            final float baseline = both ? bottom - w * mFooterLeading : bottom;
+            final float baseline = both ? bottom - ref * mFooterLeading : bottom;
             final float cap = capHeight();
