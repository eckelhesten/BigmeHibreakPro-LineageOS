From 4cdd31e3308a8733b22f377c4eaf3b27384f7de2 Mon Sep 17 00:00:00 2001
From: hibreak <build@localhost>
Date: Sun, 22 Nov 2026 00:30:28 +0000
Subject: [PATCH] fonts: e-ink Noto Sans 450 in fonts.xml

The legacy fonts.xml (read by Chromium/WebView) matches font_fallback.xml:
sans-serif is Noto Sans on the e-ink 450 weight curve with Roboto as the
first fallback (also in fallback_order.json). Generated by
scripts/dev/eink-fonts.py (docs/eink-fonts.md).

Change-Id: I75f408854ff6ff93e684ae2a03339ff6736c67ec
---
 data/fonts/fallback_order.json |   2 +
 data/fonts/fonts.xml           | 102 ++++++++++++++++-----------------
 2 files changed, 51 insertions(+), 53 deletions(-)

diff --git a/data/fonts/fallback_order.json b/data/fonts/fallback_order.json
index 2fc3f3e3f..e5ef2195f 100644
--- a/data/fonts/fallback_order.json
+++ b/data/fonts/fallback_order.json
@@ -1,4 +1,6 @@
 [
+  // E-ink: Roboto right after Noto Sans, for characters Noto Sans lacks.
+  { "id": "Roboto-Fallback" },
   { "lang": "und-Arab" },
   { "lang": "und-Ethi" },
   { "lang": "und-Hebr" },
diff --git a/data/fonts/fonts.xml b/data/fonts/fonts.xml
index 8cbc3000c..01c37c896 100644
--- a/data/fonts/fonts.xml
+++ b/data/fonts/fonts.xml
@@ -35,98 +35,81 @@
 -->
