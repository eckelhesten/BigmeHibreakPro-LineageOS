diff --git a/packages/SystemUI/src/com/android/systemui/doze/EinkDozeScreenOff.java b/packages/SystemUI/src/com/android/systemui/doze/EinkDozeScreenOff.java
index b55954d..72274e7 100644
--- a/packages/SystemUI/src/com/android/systemui/doze/EinkDozeScreenOff.java
+++ b/packages/SystemUI/src/com/android/systemui/doze/EinkDozeScreenOff.java
@@ -38,11 +38,14 @@ final class EinkDozeScreenOff {
 
     private final DozeMachine.Service mService;
     private final Handler mHandler;
+    private final WakeLock mRawWakeLock;
     private final SettableWakeLock mWakeLock;
     private final Runnable mTurnOff = this::turnOff;
 
     /** The always-on state the doze machine asked for, or STATE_UNKNOWN when it wants another. */
     private int mAlwaysOnState = Display.STATE_UNKNOWN;
+    /** Generation counter isolating posted time-tick updates from prior doze sessions. */
+    private volatile int mSessionGen;
     /** The display is off on our account while the doze machine wants it always on. */
     private boolean mOff;
     private int mSleepDelay = 3000;
@@ -51,6 +54,7 @@ final class EinkDozeScreenOff {
     EinkDozeScreenOff(DozeMachine.Service service, Handler handler, WakeLock wakeLock) {
         mService = service;
         mHandler = handler;
+        mRawWakeLock = wakeLock;
         mWakeLock = new SettableWakeLock(wakeLock, TAG);
         sInstance = this;
     }
@@ -59,6 +63,7 @@ final class EinkDozeScreenOff {
     void setDozeScreenState(int state) {
         if (state == Display.STATE_DOZE || state == Display.STATE_DOZE_SUSPEND) {
             if (mAlwaysOnState == Display.STATE_UNKNOWN) {
+                mSessionGen++;
                 mSleepDelay = SystemProperties.getInt("debug.sysui.eink_sleep.off_ms", 3000);
                 mTickDelay = SystemProperties.getInt("debug.sysui.eink_sleep.tick_ms", 1500);
             } else if (mOff) {
@@ -73,6 +78,7 @@ final class EinkDozeScreenOff {
             mAlwaysOnState = state;
             scheduleOff(mSleepDelay);
         } else {
+            mSessionGen++;
             mHandler.removeCallbacks(mTurnOff);
             mOff = false;
             mService.setDozeScreenState(state);
@@ -83,6 +89,7 @@ final class EinkDozeScreenOff {
 
     /** Dozing ends; main thread. */
     void cancel() {
+        mSessionGen++;
         mHandler.removeCallbacks(mTurnOff);
         mAlwaysOnState = Display.STATE_UNKNOWN;
         mOff = false;
@@ -101,16 +108,14 @@ final class EinkDozeScreenOff {
     static void onTimeTick() {
         EinkDozeScreenOff instance = sInstance;
         if (instance != null) {
-            // Hold the wakelock until showUpdate() runs and either schedules turnOff() or
-            // releases it, so the CPU cannot suspend before the display comes back on.
-            instance.mWakeLock.setAcquired(true);
-            instance.mHandler.post(instance::showUpdate);
+            final int gen = instance.mSessionGen;
+            // Hold a refcounted WakeLock wrapper across post() so mWakeLock stays main-thread only.
+            instance.mHandler.post(instance.mRawWakeLock.wrap(() -> instance.showUpdate(gen)));
         }
     }
 
-    private void showUpdate() {
-        if (mAlwaysOnState == Display.STATE_UNKNOWN) {
-            mWakeLock.setAcquired(false);
+    private void showUpdate(int gen) {
+        if (gen != mSessionGen || mAlwaysOnState == Display.STATE_UNKNOWN) {
             return;
         }
         mHandler.removeCallbacks(mTurnOff);
