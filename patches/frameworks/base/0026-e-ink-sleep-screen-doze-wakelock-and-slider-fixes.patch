  * Weather icons for the e-ink sleep screen: plain line drawings in one colour, with solid
@@ -30,18 +32,44 @@ final class EinkWeatherIcon {
     /** Filled with the background: hides what is behind (the sun behind a cloud). */
     private static final int KNOCKOUT = 2;
 
+    private static final class CachedIcon {
+        final List<Path> paths;
+        final List<Integer> modes;
+        final RectF bare;
+
+        CachedIcon(List<Path> paths, List<Integer> modes, RectF bare) {
+            this.paths = paths;
+            this.modes = modes;
+            this.bare = bare;
+        }
+    }
+
+    private static final Map<String, CachedIcon> CACHE = new HashMap<>();
+
     private EinkWeatherIcon() {}
 
+    private static CachedIcon getIcon(String kind, boolean day) {
+        final String key = kind + "|" + (day ? "1" : "0");
+        synchronized (CACHE) {
+            CachedIcon cached = CACHE.get(key);
+            if (cached != null) return cached;
+            List<Path> paths = new ArrayList<>();
+            List<Integer> modes = new ArrayList<>();
+            build(kind, day, paths, modes);
+            cached = new CachedIcon(paths, modes, inkBounds(paths, modes, 0f));
+            CACHE.put(key, cached);
+            return cached;
+        }
+    }
+
     /** The width {@link #draw} takes for this icon at this height. */
     static float width(String kind, boolean day, float height) {
-        List<Path> paths = new ArrayList<>();
-        List<Integer> modes = new ArrayList<>();
-        build(kind, day, paths, modes);
-        RectF bare = inkBounds(paths, modes, 0f);
+        CachedIcon icon = getIcon(kind, day);
+        RectF bare = icon.bare;
         if (bare == null || bare.isEmpty()) return 0;
         final float strokeUnits = height * STROKE_OF_HEIGHT
                 / Math.min(height / bare.height(), height * 1.3f / bare.width());
-        RectF ink = inkBounds(paths, modes, strokeUnits);
+        RectF ink = inkBounds(icon.paths, icon.modes, strokeUnits);
         return ink.width() * Math.min(height / ink.height(), height * 1.3f / ink.width());
     }
 
