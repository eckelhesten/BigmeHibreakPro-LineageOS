-        mTimePaint.setFontVariationSettings("'wght' " + mWeight + ", 'opsz' 144");
+        mTimePaint.setFontVariationSettings(
+                mTimeTypefaceIsFlex ? "'wght' " + mWeight + ", 'opsz' 144" : "'wght' " + mWeight);
         mTimePaint.setFontFeatureSettings("tnum");
         mTimePaint.setTextSize(ref * mSize);
         mTimePaint.setTextAlign(Paint.Align.CENTER);
@@ -371,20 +410,10 @@ public final class EinkSleepScreen extends View implements StatusBarStateControl
         if (footer) drawFooter(canvas, w, h, fg, bg);
 
         // Battery, small, at the bottom (at the top while the footer is shown).
-        if (mShowBattery) {
-            Intent battery = mContext.registerReceiver(null,
-                    new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
-            if (battery != null) {
-                int level = battery.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
-                int scale = battery.getIntExtra(BatteryManager.EXTRA_SCALE, 100);
-                boolean charging = battery.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) != 0;
-                if (level >= 0 && scale > 0) {
-                    mTextPaint.setTextSize(ref * 0.042f);
-                    String text = (charging ? "⚡︎ " : "") + (level * 100 / scale) + " %";
-                    canvas.drawText(text, w / 2f, footer ? ref * 0.10f : h - ref * 0.12f,
-                            mTextPaint);
-                }
-            }
+        if (mShowBattery && mBatteryText != null) {
+            mTextPaint.setTextSize(ref * 0.042f);
+            canvas.drawText(mBatteryText, w / 2f, footer ? ref * 0.10f : h - ref * 0.12f,
+                    mTextPaint);
         }
     }
 
@@ -452,12 +481,21 @@ public final class EinkSleepScreen extends View implements StatusBarStateControl
     /** "Today 14:00", "Tomorrow 09:30", "Thu 10:00"; "Today 14:00–15:00" while it runs. */
     private String describeWhen(long now) {
         final boolean running = mEventBegin <= now;
-        final String day = dayLabel(running ? now : mEventBegin, now);
-        if (mEventAllDay) return day;
+        if (mEventAllDay) return dayLabel(running ? now : mEventBegin, now);
         final java.text.DateFormat time = DateFormat.getTimeFormat(mContext);
         final String start = time.format(new Date(mEventBegin));
-        return running ? day + " " + start + "\u2013" + time.format(new Date(mEventEnd))
-                : day + " " + start;
+        if (!running) {
+            return dayLabel(mEventBegin, now) + " " + start;
+        }
+        final ZoneId zone = ZoneId.systemDefault();
+        final LocalDate startDay = LocalDate.ofInstant(Instant.ofEpochMilli(mEventBegin), zone);
+        final LocalDate endDay = LocalDate.ofInstant(Instant.ofEpochMilli(mEventEnd), zone);
+        final String end = time.format(new Date(mEventEnd));
+        if (startDay.equals(endDay)) {
+            return dayLabel(now, now) + " " + start + "\u2013" + end;
+        }
+        return dayLabel(mEventBegin, now) + " " + start + "\u2013"
+                + dayLabel(mEventEnd, now) + " " + end;
     }
 
     private String dayLabel(long when, long now) {
@@ -465,12 +503,13 @@ public final class EinkSleepScreen extends View implements StatusBarStateControl
         final long days = ChronoUnit.DAYS.between(
                 LocalDate.ofInstant(Instant.ofEpochMilli(now), zone),
                 LocalDate.ofInstant(Instant.ofEpochMilli(when), zone));
-        if (days <= 1) {
+        if (days >= 0 && days <= 1) {
             // "Today", "Tomorrow" in the phone's language.
             return DateUtils.getRelativeTimeSpanString(when, now, DateUtils.DAY_IN_MILLIS)
                     .toString();
         }
+        final String skeleton = (days > 1 && days < 7) ? "EEE" : "EEEdMMM";
         return DateFormat.format(
-                DateFormat.getBestDateTimePattern(Locale.getDefault(), "EEE"), when).toString();
+                DateFormat.getBestDateTimePattern(Locale.getDefault(), skeleton), when).toString();
