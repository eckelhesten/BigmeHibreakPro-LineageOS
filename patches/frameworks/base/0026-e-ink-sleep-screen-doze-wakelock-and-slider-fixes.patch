@@ -304,6 +311,37 @@ public final class EinkSleepScreen extends View implements StatusBarStateControl
         return Typeface.create(Typeface.create(FONT, Typeface.NORMAL), weight, false);
     }
 
+    private Typeface clockTypeface(int weight) {
+        if (CLOCK_FONT_FILE.isFile()) {
+            try {
+                Typeface tf = new Typeface.Builder(CLOCK_FONT_FILE)
+                        .setFontVariationSettings("'wght' " + weight + ", 'opsz' 144")
+                        .build();
+                mTimeTypefaceIsFlex = true;
+                return tf;
+            } catch (RuntimeException e) {
+                Log.w(TAG, "clock typeface fallback", e);
+            }
+        }
+        mTimeTypefaceIsFlex = false;
+        return typeface(weight);
+    }
+
+    private void loadBattery() {
+        mBatteryText = null;
+        if (!mShowBattery) return;
+        Intent battery = mContext.registerReceiver(null,
+                new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
+        if (battery != null) {
+            int level = battery.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
+            int scale = battery.getIntExtra(BatteryManager.EXTRA_SCALE, 100);
+            boolean charging = battery.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) != 0;
+            if (level >= 0 && scale > 0) {
+                mBatteryText = (charging ? "⚡︎ " : "") + (level * 100 / scale) + " %";
+            }
+        }
+    }
+
     @Override
     protected void onDraw(Canvas canvas) {
         final int w = getWidth();
@@ -325,12 +363,13 @@ public final class EinkSleepScreen extends View implements StatusBarStateControl
 
         // The numerals: two lines, centred, their block starting at 17 % of the height.
         if (mTimeTypeface == null || mTimeTypefaceWeight != mWeight) {
-            mTimeTypeface = typeface(mWeight);
+            mTimeTypeface = clockTypeface(mWeight);
             mTimeTypefaceWeight = mWeight;
         }
