+    /**
+     * A sleep-screen update (minute tick or notification icon change) while dozing; any thread.
+     * Brings the display back to its always-on state briefly so the panel gets the non-flashing
+     * Normal (DU) update, then turns it off again after {@code tick_ms}.
+     */
+    public static void requestUpdate() {
         EinkDozeScreenOff instance = sInstance;
-        if (instance != null) {
-            final int gen = instance.mSessionGen;
+        if (instance == null) return;
+        final int gen = instance.mSessionGen;
+        if (Looper.myLooper() == instance.mHandler.getLooper()) {
+            instance.showUpdate(gen);
+        } else {
             // Hold a refcounted WakeLock wrapper across post() so mWakeLock stays main-thread only.
             instance.mHandler.post(instance.mRawWakeLock.wrap(() -> instance.showUpdate(gen)));
         }
     }
 
+    /**
+     * Keeps the CPU awake briefly (without turning the display on) while the notification
+     * pipeline inflates and filters a newly arrived or removed notification, so the
+     * choreographer timeout can run while the display is off. Main thread.
+     */
+    public static void holdForNotification() {
+        EinkDozeScreenOff instance = sInstance;
+        if (instance != null && Looper.myLooper() == instance.mHandler.getLooper()) {
+            instance.holdPipeline();
+        }
+    }
+
+    private void holdPipeline() {
+        if (mAlwaysOnState == Display.STATE_UNKNOWN || !mOff) return;
+        final int holdMs = SystemProperties.getInt("debug.sysui.eink_sleep.notif_hold_ms", 1000);
+        if (holdMs <= 0) return;
+        mHandler.removeCallbacks(mReleasePipeline);
+        mPipelineWakeLock.setAcquired(true);
+        mHandler.postDelayed(mReleasePipeline, holdMs);
+    }
+
+    private void releasePipeline() {
+        mHandler.removeCallbacks(mReleasePipeline);
+        mPipelineWakeLock.setAcquired(false);
+    }
+
     private void showUpdate(int gen) {
         if (gen != mSessionGen || mAlwaysOnState == Display.STATE_UNKNOWN) {
             return;
         }
+        releasePipeline();
         mHandler.removeCallbacks(mTurnOff);
+        int delay = mTickDelay;
         if (mOff) {
             mOff = false;
             mService.setDozeScreenState(mAlwaysOnState);
+        } else if (mOffAt > 0 && delay >= 0) {
+            // Do not shorten a longer pending window (e.g. the initial sleep hold).
+            long remaining = mOffAt - SystemClock.uptimeMillis();
+            if (remaining > delay) delay = (int) remaining;
         }
-        scheduleOff(mTickDelay);
+        scheduleOff(delay);
     }
 
     private void scheduleOff(int delay) {
         if (delay < 0) {
             // Negative: the display stays on (the behaviour before this class).
+            mOffAt = 0;
             mWakeLock.setAcquired(false);
             return;
         }
         // Awake until the display is off: the handler's clock stops while the CPU sleeps.
+        mOffAt = SystemClock.uptimeMillis() + delay;
         mWakeLock.setAcquired(true);
         mHandler.postDelayed(mTurnOff, delay);
     }
 
     private void turnOff() {
+        mOffAt = 0;
         if (mAlwaysOnState != Display.STATE_UNKNOWN && !mOff) {
             if (DozeService.DEBUG) Log.d(TAG, "display off until the next update");
             mOff = true;
