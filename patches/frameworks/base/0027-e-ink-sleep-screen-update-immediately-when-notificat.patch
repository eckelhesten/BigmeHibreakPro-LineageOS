+    private static boolean isAlerting(NotificationEntry entry) {
+        StatusBarNotification sbn = entry.getSbn();
+        NotificationListenerService.Ranking ranking = entry.getRanking();
+        return sbn != null && ranking != null
+                && ranking.getImportance() >= NotificationManager.IMPORTANCE_DEFAULT;
+    }
+
+    private static void collectFromPipelineEntry(PipelineEntry entry, Set<String> seen,
+            List<IconSpec> specs, List<StatusBarNotification> sbns) {
+        if (entry instanceof NotificationEntry ne) {
+            addNotificationSpec(ne, seen, specs, sbns);
+        } else if (entry instanceof GroupEntry group) {
+            NotificationEntry summary = group.getSummary();
+            if (summary != null && isAlerting(summary)
+                    && addNotificationSpec(summary, seen, specs, sbns)) {
+                return;
+            }
+            for (NotificationEntry child : group.getChildren()) {
+                if (specs.size() >= MAX_ICONS) break;
+                if (isAlerting(child) && addNotificationSpec(child, seen, specs, sbns)) {
+                    break;
+                }
+            }
+        } else if (entry instanceof BundleEntry bundle) {
+            for (ListEntry child : bundle.getChildren()) {
+                if (specs.size() >= MAX_ICONS) break;
+                collectFromPipelineEntry(child, seen, specs, sbns);
+            }
+        }
+    }
+
+    private static boolean addNotificationSpec(NotificationEntry entry, Set<String> seen,
+            List<IconSpec> specs, List<StatusBarNotification> sbns) {
+        if (!isAlerting(entry)) return false;
+        StatusBarNotification sbn = entry.getSbn();
+        String pkg = sbn.getPackageName();
+        if (seen.contains(pkg)) return false;
+        Icon icon = sbn.getNotification().getSmallIcon();
+        if (icon == null) return false;
+        seen.add(pkg);
+        specs.add(new IconSpec(pkg, icon));
+        sbns.add(sbn);
+        return true;
+    }
+
+    private void collectFromStack(Set<String> seen, List<IconSpec> specs,
+            List<StatusBarNotification> sbns) {
+        ViewGroup stack = mNotifications.getView();
+        for (int i = 0; i < stack.getChildCount() && specs.size() < MAX_ICONS; i++) {
+            if (!(stack.getChildAt(i) instanceof ExpandableNotificationRow row)) continue;
+            if (row.getVisibility() != View.VISIBLE || row.isRemoved()) continue;
+            // The two notification pipelines (bundle UI flag) hand out the entry differently.
+            StatusBarNotification sbn;
+            NotificationListenerService.Ranking ranking;
+            if (NotificationBundleUi.isEnabled()) {
+                EntryAdapter adapter = row.getEntryAdapter();
+                if (adapter == null || adapter.isBundle()) continue;
+                sbn = adapter.getSbn();
+                ranking = adapter.getRanking();
+            } else {
+                NotificationEntry entry = row.getEntryLegacy();
+                if (entry == null) continue;
+                sbn = entry.getSbn();
+                ranking = entry.getRanking();
+            }
+            if (sbn == null || ranking == null
+                    || ranking.getImportance() < NotificationManager.IMPORTANCE_DEFAULT) {
+                continue;
+            }
+            String pkg = sbn.getPackageName();
+            if (seen.contains(pkg)) continue;
+            Icon icon = sbn.getNotification().getSmallIcon();
+            if (icon == null) continue;
+            seen.add(pkg);
+            specs.add(new IconSpec(pkg, icon));
+            sbns.add(sbn);
+        }
+    }
+
+    private static boolean sameIconSpecs(List<IconSpec> a, List<IconSpec> b) {
+        if (a.size() != b.size()) return false;
+        for (int i = 0; i < a.size(); i++) {
+            if (!a.get(i).sameAs(b.get(i))) return false;
+        }
+        return true;
     }
 
