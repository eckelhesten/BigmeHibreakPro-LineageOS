+    /**
+     * Hooks the notification pipeline once so arriving, updated or dismissed notifications update
+     * the sleep screen's icon row immediately (without waiting for the next minute tick).
+     */
+    public static void attachPipeline(NotifPipeline pipeline) {
+        if (!ENABLED || sPipelineAttached) return;
+        sPipelineAttached = true;
+        pipeline.addCollectionListener(new NotifCollectionListener() {
+            @Override
+            public void onEntryAdded(NotificationEntry entry) {
+                onCollectionEvent(entry, false);
+            }
+
+            @Override
+            public void onEntryUpdated(NotificationEntry entry) {
+                onCollectionEvent(entry, true);
+            }
+
+            @Override
+            public void onEntryRemoved(NotificationEntry entry, int reason) {
+                onCollectionEvent(entry, true);
+            }
+        });
+        pipeline.addOnAfterRenderListListener(entries -> {
+            sLastEntries = new ArrayList<>(entries);
+            EinkSleepScreen view = sInstance;
+            if (view != null) view.onNotificationsChanged();
+        });
+    }
+
+    private static void onCollectionEvent(NotificationEntry entry, boolean checkDisplayed) {
+        EinkSleepScreen view = sInstance;
+        if (view == null || view.getVisibility() != VISIBLE || !view.mShowIcons) return;
+        boolean relevant = isAlerting(entry);
+        if (!relevant && checkDisplayed) {
+            StatusBarNotification sbn = entry.getSbn();
+            if (sbn != null) {
+                String pkg = sbn.getPackageName();
+                for (IconSpec spec : view.mIconSpecs) {
+                    if (spec.pkg.equals(pkg)) {
+                        relevant = true;
+                        break;
+                    }
+                }
+            }
+        }
+        if (relevant) {
+            EinkDozeScreenOff.holdForNotification();
+        }
+    }
