         state.mKeyguardShowing = keyguardShowing;
         state.mAodShowing = aodShowing;
         state.writeEventLog("setKeyguardShown");
@@ -321,6 +327,13 @@ class KeyguardController {
             Trace.traceEnd(TRACE_TAG_WINDOW_MANAGER);
             return;
         }
+        // E-ink: SurfaceFlinger holds the panel until the screen behind the keyguard has settled.
+        for (int i = changedDisplays.size() - 1; i >= 0; i--) {
+            if (changedDisplays.get(i).mDisplayId == DEFAULT_DISPLAY) {
+                com.android.server.policy.EinkPanelSignals.keyguardGoingAway();
+                break;
+            }
+        }
 
         mService.deferWindowLayout();
         final ActionChain chain = mService.mChainTracker.startTransit("kgGoAway");
