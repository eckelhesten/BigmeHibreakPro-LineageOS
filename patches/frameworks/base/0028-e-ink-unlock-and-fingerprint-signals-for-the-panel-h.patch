             mWindowManager.mTaskSnapshotController.snapshotForSleeping(DEFAULT_DISPLAY);
         }
 
+        // E-ink: the keyguard hidden without going away first (a fingerprint match that woke the
+        // phone: SystemUI hides it at once) is an unlock too, for SurfaceFlinger's panel hold.
+        if (displayId == DEFAULT_DISPLAY && !keyguardShowing && state.mKeyguardShowing
+                && !state.mKeyguardGoingAway) {
+            com.android.server.policy.EinkPanelSignals.keyguardGoingAway();
