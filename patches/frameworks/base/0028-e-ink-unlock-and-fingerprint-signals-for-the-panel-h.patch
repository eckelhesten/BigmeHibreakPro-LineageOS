                 new AuthenticationErrorInfo.Builder(BiometricSourceType.FINGERPRINT,
                         getRequestReason(), getErrorString(getContext(), errorCode, vendorCode),
diff --git a/services/core/java/com/android/server/policy/EinkPanelSignals.java b/services/core/java/com/android/server/policy/EinkPanelSignals.java
new file mode 100644
index 000000000..d2e9860c6
--- /dev/null
+++ b/services/core/java/com/android/server/policy/EinkPanelSignals.java
@@ -0,0 +1,104 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.server.policy;
+
+import static android.hardware.biometrics.BiometricFingerprintConstants.FINGERPRINT_ACQUIRED_VENDOR;
+
+import android.os.SystemClock;
+import android.os.SystemProperties;
+import android.util.Slog;
+
+/**
+ * E-ink (HiBreak Pro): tells SurfaceFlinger (frameworks/native EinkMotion) about an unlock and a
+ * finger on the fingerprint sensor, so that it can hold the panel until the screen behind them
+ * has settled, as it does when the phone goes to sleep or wakes up (vendor.xrz.hibreak_sleep,
+ * PhoneWindowManager).
+ *
+ * vendor.xrz.hibreak_sleep: written here too, by the power manager at the change itself;
+ * PhoneWindowManager's write comes from the main thread, which a fingerprint wake-up can keep
+ * busy for ~0.5 s.
+ *
+ * vendor.xrz.hibreak_unlock: the uptime in ms of the last keyguard going away. The lock screen
+ * then goes to home (or the app) in one panel update.
+ *
+ * vendor.xrz.hibreak_finger: the uptime in ms of the last acquire of the keyguard's fingerprint
+ * authentication, 0 once the sensor has answered without a match (rejected, lifted, error or
+ * cancelled). A match leaves the time, refreshed: the unlock follows within a few ms, and the
+ * wake hold must not let the lock screen out in between. SurfaceFlinger only acts on it during
+ * the hold of a wake-up: the side sensor is the power button, so a press with an enrolled finger
+ * is a wake-up followed by an unlock, and the lock screen waits for the sensor's answer.
+ *
+ * The HAL (MICROARRAY, fingerprint@2.1) reports vendor acquires (seen 2026-11-24): 1 when a
+ * capture is armed with no finger (each session's start, after a lift), 2 when a finger lands,
+ * 3 when it lifts. 1 is no finger; 3 ends the read. Both are runtime properties
+ * (debug.sf.eink_finger.idle_code, .lifted_code; -1 = none) in case another firmware differs.
+ */
+public final class EinkPanelSignals {
+    private static final String TAG = "EinkPanelSignals";
+    private static final boolean ENABLED =
+            SystemProperties.getBoolean("debug.sf.eink_motion", false)
+                    && SystemProperties.getBoolean("debug.sf.eink_sleep", true);
+    private static final String UNLOCK = "vendor.xrz.hibreak_unlock";
+    private static final String FINGER = "vendor.xrz.hibreak_finger";
+
+    private static boolean sFinger;  // FINGER holds a time
+    private static boolean sMatched; // the last read matched: leave FINGER for the unlock
+
+    private EinkPanelSignals() {}
+
+    /**
+     * The default display group starts going to sleep or waking up (vendor.xrz.hibreak_sleep,
+     * also written by PhoneWindowManager): called by the power manager's Notifier at once.
+     */
+    public static void setAsleep(boolean asleep) {
+        if (!ENABLED) return;
+        set("vendor.xrz.hibreak_sleep", asleep ? "1" : "0");
+    }
+
+    /** The keyguard is going away on the default display. */
+    public static void keyguardGoingAway() {
+        if (!ENABLED) return;
+        set(UNLOCK, Long.toString(SystemClock.uptimeMillis()));
+    }
+
+    /** An acquire of the keyguard's fingerprint authentication. */
+    public static synchronized void fingerAcquired(int acquiredInfo, int vendorCode) {
+        if (!ENABLED) return;
+        if (acquiredInfo == FINGERPRINT_ACQUIRED_VENDOR) {
+            if (vendorCode == SystemProperties.getInt("debug.sf.eink_finger.idle_code", 1)) return;
+            if (vendorCode == SystemProperties.getInt("debug.sf.eink_finger.lifted_code", 3)) {
+                fingerDone();
+                return;
+            }
+        }
+        sMatched = false;
+        sFinger = true;
+        set(FINGER, Long.toString(SystemClock.uptimeMillis()));
+    }
+
+    /** The keyguard's fingerprint authentication matched: the unlock follows. */
+    public static synchronized void fingerMatched() {
+        if (!ENABLED) return;
+        sMatched = true;
+        sFinger = true;
+        set(FINGER, Long.toString(SystemClock.uptimeMillis()));
+    }
+
+    /** The sensor answered without a match, or the authentication ended. */
+    public static synchronized void fingerDone() {
+        if (!ENABLED || !sFinger || sMatched) return;
+        sFinger = false;
+        set(FINGER, "0");
+    }
+
+    private static void set(String key, String value) {
+        try {
+            SystemProperties.set(key, value);
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Could not set " + key, e);
+        }
+    }
+}
