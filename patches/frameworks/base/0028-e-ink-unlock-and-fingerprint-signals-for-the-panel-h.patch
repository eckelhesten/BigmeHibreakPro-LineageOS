 packages/SystemUI/proguard.flags              |   7 ++
 .../impl/SystemUIApplicationImpl.java         |  39 +++++++
 .../aidl/FingerprintAuthenticationClient.java |  17 +++
 .../server/policy/EinkPanelSignals.java       | 104 ++++++++++++++++++
 .../com/android/server/power/Notifier.java    |   6 +
 .../android/server/wm/KeyguardController.java |  13 +++
 6 files changed, 186 insertions(+)
 create mode 100644 services/core/java/com/android/server/policy/EinkPanelSignals.java

diff --git a/packages/SystemUI/proguard.flags b/packages/SystemUI/proguard.flags
index 42b592346..be9b17b98 100644
--- a/packages/SystemUI/proguard.flags
+++ b/packages/SystemUI/proguard.flags
@@ -5,3 +5,10 @@
 }
 
 -keep,allowoptimization,allowaccessmodification class com.android.systemui.dagger.DaggerReferenceGlobalRootComponent** { !synthetic *; }
+
+# E-ink (debug.sysui.eink_palette): SystemUIApplicationImpl sets AndroidX's animator duration
+# scale to 0 by reflection. Without this, R8 removes the setter and folds the scale to 1.
+-keep class androidx.core.animation.ValueAnimator {
+    static void setDurationScale(float);
+    static float sDurationScale;
+}
diff --git a/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java b/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java
index 00887f7b4..dfb3e5d4c 100644
--- a/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java
+++ b/packages/SystemUI/src/com/android/systemui/application/impl/SystemUIApplicationImpl.java
@@ -17,6 +17,7 @@
 package com.android.systemui.application.impl;
 
 import android.animation.Animator;
+import android.animation.ValueAnimator;
 import android.annotation.SuppressLint;
 import android.app.ActivityThread;
 import android.content.BroadcastReceiver;
@@ -25,6 +26,7 @@ import android.content.Intent;
 import android.content.IntentFilter;
 import android.content.res.Configuration;
 import android.os.Process;
+import android.os.SystemProperties;
 import android.os.Trace;
 import android.tracing.perfetto.InitArguments;
 import android.util.Log;
@@ -85,6 +87,42 @@ public class SystemUIApplicationImpl extends SystemUIApplication implements
     private SystemUIInitializer mInitializer;
     private ProcessWrapper mProcessWrapper;
 
+    /**
+     * E-ink (debug.sysui.eink_palette), opt-in only: with debug.sysui.eink_animations=0 SystemUI
+     * draws without animations, as with the animator duration scale at 0 for this process only.
+     * Off by default (owner, 2026-11-24: animations stay on). Each animation frame is a panel refresh, and
+     * the lock screen's (clock, status bar, navigation bar, scrims) ran for ~1 s after every
+     * wake-up: SurfaceFlinger's wake hold (frameworks/native EinkMotion) never saw a still screen,
+     * let the panel go mid-animation at its limit and sent the rest as FAST updates. The scale
+     * the window manager sets (the global setting) is put back to 0 whenever it changes.
+     * AndroidX's animators (androidx.core.animation: the light-reveal scrim, the notifications'
+     * wake-up, the keyguard status bar, 500 ms each after a wake-up) have a scale of their own
+     * that nothing else sets; it is set to 0 by reflection (kept by proguard.flags).
+     * Read when SystemUI starts; default 1 (animations on).
+     */
+    private static ValueAnimator.DurationScaleChangeListener sEinkNoAnimations;
+
+    private static void disableAnimationsOnEink() {
+        if (!SystemProperties.getBoolean("debug.sysui.eink_palette", false)
+                || SystemProperties.getBoolean("debug.sysui.eink_animations", true)) {
+            return;
+        }
+        // Held here: ValueAnimator keeps its listeners as weak references.
+        sEinkNoAnimations = scale -> {
+            if (scale != 0f) ValueAnimator.setDurationScale(0f);
+        };
+        ValueAnimator.registerDurationScaleChangeListener(sEinkNoAnimations);
+        ValueAnimator.setDurationScale(0f);
+        try {
+            final java.lang.reflect.Method setScale = androidx.core.animation.ValueAnimator.class
+                    .getDeclaredMethod("setDurationScale", float.class);
+            setScale.setAccessible(true);
+            setScale.invoke(null, 0f);
+        } catch (ReflectiveOperationException | RuntimeException e) {
+            Log.w(TAG, "e-ink: AndroidX animators keep their durations", e);
+        }
+    }
+
     public SystemUIApplicationImpl() {
         super();
         if (!isSubprocess()) {
@@ -118,6 +156,7 @@ public class SystemUIApplicationImpl extends SystemUIApplication implements
     public void onCreate() {
         super.onCreate();
         Log.v(TAG, "SystemUIApplication created.");
+        disableAnimationsOnEink();
         // This line is used to setup Dagger's dependency injection and should be kept at the
         // top of this method.
         TimingsTraceLog log = new TimingsTraceLog("SystemUIBootTiming",
