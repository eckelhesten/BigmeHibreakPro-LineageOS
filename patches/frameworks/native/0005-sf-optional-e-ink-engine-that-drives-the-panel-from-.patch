+// DRM_IOCTL_EINK_UPDATE of the XRZ e-ink driver; layout from the vendor composer
+// (hwcomposer.mt6877.so, mtk_commit), see docs/eink-interface.md.
+struct drm_eink_update {
+    uint32_t mode;
+    uint32_t left, top, right, bottom; // inclusive
+    uint32_t dither;
+    uint64_t zero0[2];
+    int32_t fd;      // dma-buf, 8-bit grey in panel orientation
+    uint32_t format; // 0 = 8-bit grey
+    uint64_t zero1;
+    uint32_t width, height;
+    uint32_t zero2;
+} __attribute__((packed));
+static_assert(sizeof(drm_eink_update) == 0x44, "drm_eink_update size");
+constexpr unsigned long kEinkUpdate = 0xc04464cfu;
+
+// Legacy ION API of the MediaTek 4.19 kernel.
+struct ion_heap_data {
+    char name[32];
+    uint32_t type, heap_id, reserved0, reserved1, reserved2;
+};
+struct ion_heap_query {
+    uint32_t cnt, reserved0;
+    uint64_t heaps;
+    uint32_t reserved1, reserved2;
+};
+struct ion_allocation_data_legacy {
+    uint64_t len, align;
+    uint32_t heap_id_mask, flags;
+    int32_t handle;
+    uint32_t pad;
+};
+struct ion_fd_data {
+    int32_t handle, fd;
+};
+constexpr unsigned long kIonHeapQuery = 0xc0184908u;
+constexpr unsigned long kIonAllocLegacy = 0xc0204900u;
+constexpr unsigned long kIonShare = 0xc0084904u;
+constexpr uint32_t kIonHeapTypeSystem = 0;
+
+constexpr uint32_t kModeGL16 = 32;
+constexpr uint32_t kModeGC16 = 4;
+constexpr uint32_t kModeA2 = 16;
+constexpr uint32_t kModeDU = 2;
+constexpr size_t kMaxRectsV1 = 6;
+constexpr size_t kTile = 32;
+constexpr uint32_t kHandoverFrames = 5; // frames the vendor composer commits after boot
+// Policy 1 motion detection (fixed, as flashed on 2026-11-13).
+constexpr nsecs_t kMotionGapV1 = 100 * 1000 * 1000;
+constexpr int64_t kMotionAreaDiv = 12;
+constexpr uint32_t kMotionFramesV1 = 3;
+// After a GC16, this many invisible updates push it out of the kernel's last-ten list.
+constexpr uint32_t kFlushUpdates = 10;
+constexpr nsecs_t kFlushSpacing = 60 * 1000 * 1000;
+
+Rect unite(const Rect& a, const Rect& b) {
+    return Rect(std::min(a.left, b.left), std::min(a.top, b.top), std::max(a.right, b.right),
+                std::max(a.bottom, b.bottom));
+}
+
+int64_t area(const Rect& r) {
+    return int64_t{r.getWidth()} * r.getHeight();
+}
+
+// Merges the pair whose bounding box adds the least area until at most maxRects remain.
+void reduceRects(std::vector<Rect>* rects, size_t maxRects) {
+    while (rects->size() > std::max<size_t>(1, maxRects)) {
+        size_t bi = 0, bj = 1;
+        int64_t best = INT64_MAX;
+        for (size_t i = 0; i < rects->size(); i++) {
+            for (size_t j = i + 1; j < rects->size(); j++) {
+                const int64_t added = area(unite((*rects)[i], (*rects)[j])) - area((*rects)[i]) -
+                        area((*rects)[j]);
+                if (added < best) {
+                    best = added;
+                    bi = i;
+                    bj = j;
+                }
+            }
+        }
+        (*rects)[bi] = unite((*rects)[bi], (*rects)[bj]);
+        rects->erase(rects->begin() + static_cast<std::ptrdiff_t>(bj));
+    }
+}
+
+// Ghosting a waveform leaves behind, per full panel drawn, in thousandths: the fast modes leave
+// ghosts that only GC16 removes (docs/eink-interface.md, rule 8). GL16 screen changes leave
+// visible ghosts of the previous screen too (camera, 2026-11-14), with or without auto-clean.
+uint32_t ghostWeight(uint32_t mode) {
+    switch (mode & 0xff) {
+        case 2: case 3: case 0x10: case 0x11: case 0x89: case 0xb2: case 0xb3: case 0xb7:
+            return 1000;
+        case 0x20: case 0x21: case 0x40: case 0x84: case 0xb1: case 0xb4:
+            return 500;
+        default:
+            return 0;
+    }
+}
+
+bool isGc16(uint32_t mode) {
+    const uint32_t m = mode & 0xff;
+    return m == kModeGC16 || m == 7 || m == 0xb0;
+}
+
+uint32_t readUint(const prop_info* pi, uint32_t fallback) {
+    if (!pi) return fallback;
+    uint32_t value = fallback;
+    __system_property_read_callback(
+            pi,
+            [](void* cookie, const char*, const char* v, uint32_t) {
+                char* end = nullptr;
+                unsigned long parsed = strtoul(v, &end, 0);
+                if (end != v) *static_cast<uint32_t*>(cookie) = static_cast<uint32_t>(parsed);
+            },
+            &value);
+    return value;
+}
+
+uint32_t prop(const char* name, uint32_t fallback) {
+    return base::GetUintProperty<uint32_t>(name, fallback);
+}
+
+nsecs_t propMs(const char* name, uint32_t fallbackMs) {
+    return ms2ns(base::GetUintProperty<uint32_t>(name, fallbackMs));
+}
+
