+void EinkEngine::loadConfig() {
+    Config c;
+    c.policy = prop("debug.sf.eink.policy", 3);
+    c.mergeDist = static_cast<int32_t>(std::min(prop("debug.sf.eink.merge_px", 96), 2000u));
+    c.maxRegions = std::clamp(prop("debug.sf.eink.max_regions", 2), 1u, 4u);
+    c.greyShare = std::min(prop("debug.sf.eink.grey_share", 25), 100u);
+    // Without the kernel's own A2 cleanup, ghosting builds up until a GC16 removes it; like an
+    // e-reader's "full refresh every N pages", one GC16 follows once enough has built up.
+    // About every 4th new screen (8th with auto-clean), like KOReader's default of every 6th page.
+    c.fullAfter = prop("debug.sf.eink.full_after",
+                       base::GetBoolProperty("vendor.xrz.auto_clean_enabled", true) ? 8 : 4);
+    c.defaultMode = prop("debug.sf.eink.mode", 0xb2);
+    c.cleanDelay = propMs("debug.sf.eink.clean_ms", c.policy < 2 ? 800 : 0);
+    c.tapBw = prop("debug.sf.eink.tap_bw", kModeA2);
+    c.tapGrey = prop("debug.sf.eink.tap_grey", kModeGL16);
+    c.screenMode = prop("debug.sf.eink.screen_mode", kModeGL16);
+    c.screenWait = propMs("debug.sf.eink.screen_wait_ms", 120);
+    c.greyPixels = std::max(1u, prop("debug.sf.eink.grey_px", 48));
+    c.maxRects = std::clamp(prop("debug.sf.eink.max_rects", 4), 1u, 8u);
+    // DU, as the stock firmware scrolls: the kernel's auto-clean removes DU's ghosts, but A2
+    // leaves ghosts that no grey settle removes (camera, Settings flings, 2026-11-14). Only
+    // "Fast" (A2 everywhere) and "Clear" (a GC16 settle) use A2 for motion.
+    c.motionMode = prop("debug.sf.eink.motion_mode", kModeDU);
+    c.motionInterval = propMs("debug.sf.eink.motion_ms", 90);
+    c.motionGap = propMs("debug.sf.eink.motion_gap_ms", 100);
+    c.motionEnd = propMs("debug.sf.eink.motion_end_ms", 250);
+    c.motionFrames = std::max(2u, prop("debug.sf.eink.motion_frames", 3));
+    c.settleMode = prop("debug.sf.eink.settle_mode", kModeGL16);
+    c.settleDelay = propMs("debug.sf.eink.settle_ms", 150);
+    c.deepFrames = prop("debug.sf.eink.deep_frames", 0);
+    c.log = base::GetBoolProperty("debug.sf.eink.log", false);
+    c.convertThreads = std::clamp(prop("debug.sf.eink.convert_threads", 4), 1u, 8u);
+    c.black = base::GetIntProperty("debug.sf.eink.black", 48, 0, 254);
+    c.white = std::max(c.black + 1, base::GetIntProperty("debug.sf.eink.white", 208, 1, 255));
+    for (int v = 0; v < 256; v++) {
+        int out = v <= c.black ? 0 : v >= c.white ? 255 : (v - c.black) * 255 / (c.white - c.black);
+        mLut[v] = static_cast<uint8_t>(out);
+    }
+    if (c.policy != mConfig.policy) ALOGI("policy %u", c.policy);
+    mConfig = c;
+}
+
+void EinkEngine::reloadConfigIfChanged() {
+    // The global serial changes with every property write anywhere; reloading is cheap.
+    const uint32_t serial = __system_property_area_serial();
+    if (serial == mPropSerial) return;
+    mPropSerial = serial;
+    loadConfig();
+}
+
+bool EinkEngine::allocate(uint32_t size) {
+    int ion = open("/dev/ion", O_RDONLY | O_CLOEXEC);
+    if (ion < 0) {
+        ALOGE("open /dev/ion: %s", strerror(errno));
+        return false;
+    }
+    ion_heap_data heaps[32];
+    ion_heap_query query = {.cnt = 32, .heaps = reinterpret_cast<uintptr_t>(heaps)};
+    int heap = -1;
+    if (ioctl(ion, kIonHeapQuery, &query) == 0) {
+        for (uint32_t i = 0; i < query.cnt && heap < 0; i++) {
+            if (heaps[i].type == kIonHeapTypeSystem) heap = static_cast<int>(heaps[i].heap_id);
+        }
+    }
+    if (heap < 0) {
+        ALOGE("no ION system heap");
+        close(ion);
+        return false;
+    }
+    ion_allocation_data_legacy alloc = {.len = size, .align = 4096,
+                                        .heap_id_mask = 1u << heap};
+    ion_fd_data share = {};
+    if (ioctl(ion, kIonAllocLegacy, &alloc) != 0) {
+        ALOGE("ION alloc: %s", strerror(errno));
+        close(ion);
+        return false;
+    }
+    share.handle = alloc.handle;
+    const int rc = ioctl(ion, kIonShare, &share);
+    close(ion);
+    if (rc != 0) {
+        ALOGE("ION share: %s", strerror(errno));
+        return false;
+    }
+    // The kernel caches mapped buffers by fd number across processes, so a number used by an
+    // earlier SurfaceFlinger would show that (dead) buffer. Pick a free fd starting from our pid
+    // without clobbering any existing descriptor.
+    const int wanted = 512 + static_cast<int>(getpid() % 400);
+    const int moved = fcntl(share.fd, F_DUPFD_CLOEXEC, wanted);
+    if (moved < 0) {
+        ALOGE("F_DUPFD_CLOEXEC from %d: %s", wanted, strerror(errno));
+        close(share.fd);
+        return false;
+    }
+    close(share.fd);
+    mBufferFd = moved;
+    void* map = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, mBufferFd, 0);
+    if (map == MAP_FAILED) {
+        ALOGE("mmap: %s", strerror(errno));
+        close(mBufferFd);
+        mBufferFd = -1;
+        return false;
+    }
+    mGrey = static_cast<uint8_t*>(map);
+    memset(mGrey, 0xff, size);
+    mShadow.assign(size, 0xff);
+    return true;
+}
+
+bool EinkEngine::init(uint32_t width, uint32_t height) {
+    if (mInitDone) return !mInitFailed && width == mWidth && height == mHeight;
+    mInitDone = true;
+    mInitFailed = true;
+    mWidth = width;
+    mHeight = height;
+    mCard = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
+    if (mCard < 0) {
+        ALOGE("open /dev/dri/card0: %s", strerror(errno));
+        return false;
+    }
+    if (!allocate(width * height)) {
+        close(mCard);
+        mCard = -1;
+        return false;
+    }
+    mTilesX = (width + kTile - 1) / kTile;
+    mTilesY = (height + kTile - 1) / kTile;
+    mTileChanged.assign(mTilesX * mTilesY, 0);
+    mGreyCount.assign(mTilesX * mTilesY, 0);
+    mModeProp = __system_property_find("vendor.xrz.global_refresh_mode");
+    mForceProp = __system_property_find("vendor.xrz.force_global_refresh_mode");
+    if (mForceProp) mForceSerial = __system_property_serial(mForceProp);
+    // The engine is a process-lifetime singleton, so the thread is never joined.
+    std::thread(&EinkEngine::workLoop, this).detach();
+    mInitFailed = false;
+    ALOGI("e-ink engine on: %ux%u, buffer fd %d, policy %u", width, height, mBufferFd,
+          mConfig.policy);
+    return true;
+}
+
+Region EinkEngine::convert(const sp<GraphicBuffer>& buffer, const Region& region,
+                           std::vector<uint8_t>* greyTiles) {
+    Region changed;
+    const PixelFormat format = buffer->getPixelFormat();
+    const bool bgra = format == PIXEL_FORMAT_BGRA_8888;
+    if (!bgra && format != PIXEL_FORMAT_RGBA_8888 && format != PIXEL_FORMAT_RGBX_8888) {
+        ALOGE("unsupported client target format %d", format);
+        return changed;
+    }
+    void* vaddr = nullptr;
+    const Rect bounds = region.getBounds();
+    if (buffer->lock(GRALLOC_USAGE_SW_READ_OFTEN, bounds, &vaddr) != NO_ERROR || !vaddr) {
+        ALOGE("lock client target failed");
+        return changed;
+    }
+    const uint8_t* src = static_cast<const uint8_t*>(vaddr);
+    const size_t stride = buffer->getStride() * 4;
+    const int ri = bgra ? 2 : 0, bi = bgra ? 0 : 2;
+    std::vector<uint8_t> dirty(mTilesX * mTilesY, 0);
+    if (greyTiles) std::fill(mGreyCount.begin(), mGreyCount.end(), 0);
+    const nsecs_t start = systemTime();
+    const std::vector<Rect> rects(region.begin(), region.end());
+    const bool countGrey = greyTiles != nullptr;
+    const int32_t black = mConfig.black;
+    // Fixed-point form of the black/white clamp (mLut), so the loop has no table lookup.
+    const int32_t scale = (255 << 16) / std::max(16, mConfig.white - mConfig.black);
+    // Reading the uncached mapping is bound by memory latency, not by one core's speed, so
+    // several threads read faster together. Each thread takes whole tile rows (row / kTile %
+    // threads), so no two threads write the same tile counters, shadow rows or buffer rows.
+    const auto work = [&](size_t part, size_t parts) {
+        std::vector<uint8_t> line;
+        for (const Rect& r : rects) {
+            const size_t left = static_cast<size_t>(r.left);
+            const size_t bytes = static_cast<size_t>(r.getWidth()) * 4;
+            if (line.size() < bytes) line.resize(bytes);
+            for (int32_t y = r.top; y < r.bottom; y++) {
+                const size_t row = static_cast<size_t>(y);
+                if ((row / kTile) % parts != part) continue;
+                // The client target mapping is uncached: byte reads from it cost ~100 ns each.
+                // One memcpy per row (wide loads) into a cached line buffer is ~50x faster.
+                memcpy(line.data(), src + row * stride + left * 4, bytes);
+                const uint8_t* s = line.data();
+                const size_t offset = row * mWidth + left;
+                // Compared against the cached shadow: the ION buffer is mapped uncached too.
+                uint8_t* tileRow = dirty.data() + (row / kTile) * mTilesX;
+                uint16_t* greyRow = mGreyCount.data() + (row / kTile) * mTilesX;
+                bool rowChanged = false;
+                // One tile-wide chunk at a time: the grey values are computed branch-free (the
+                // compiler vectorises this), then compared with the shadow as a whole.
+                for (size_t x0 = left; x0 < static_cast<size_t>(r.right);) {
+                    const size_t x1 = std::min((x0 / kTile + 1) * kTile,
+                                               static_cast<size_t>(r.right));
+                    const size_t n = x1 - x0;
+                    uint8_t out[kTile];
+                    uint32_t greys = 0;
+                    for (size_t i = 0; i < n; i++, s += 4) {
+                        // BT.601 luma, then the black/white clamp for crisp text.
+                        const int32_t luma = (s[ri] * 77 + s[1] * 150 + s[bi] * 29) >> 8;
+                        const int32_t v = std::clamp(((luma - black) * scale) >> 16, 0, 255);
+                        out[i] = static_cast<uint8_t>(v);
+                        greys += static_cast<uint32_t>(v != 0 && v != 255);
+                    }
+                    uint8_t* d = mShadow.data() + row * mWidth + x0;
+                    if (memcmp(out, d, n) != 0) {
+                        memcpy(d, out, n);
+                        tileRow[x0 / kTile] = 1;
+                        rowChanged = true;
+                    }
+                    if (countGrey) {
+                        greyRow[x0 / kTile] = static_cast<uint16_t>(greyRow[x0 / kTile] + greys);
+                    }
+                    x0 = x1;
+                }
+                if (rowChanged) {
+                    memcpy(mGrey + offset, mShadow.data() + offset,
+                           static_cast<size_t>(r.getWidth()));
+                }
+            }
+        }
+    };
+    const int64_t pixels = area(bounds);
+    const size_t parts = pixels >= 128 * 1024 ? mConfig.convertThreads : 1;
+    std::vector<std::thread> helpers;
+    for (size_t i = 1; i < parts; i++) helpers.emplace_back(work, i, parts);
+    work(0, parts);
+    for (std::thread& t : helpers) t.join();
+    buffer->unlock();
+    const nsecs_t took = systemTime() - start;
+    mConvertTotal += took;
+    mConvertMax = std::max(mConvertMax, took);
+    if (++mConvertCount == 300) {
+        ALOGI("convert: %" PRId64 " us average, %" PRId64 " us max over 300 frames",
+              ns2us(mConvertTotal / 300), ns2us(mConvertMax));
+        mConvertCount = 0;
+        mConvertTotal = 0;
+        mConvertMax = 0;
+    }
+    if (greyTiles) {
+        greyTiles->assign(mTilesX * mTilesY, 0);
+        for (size_t i = 0; i < greyTiles->size(); i++) {
+            (*greyTiles)[i] = dirty[i] && mGreyCount[i] >= mConfig.greyPixels;
+        }
+    }
+    changed = tileRegion(dirty);
+    mDirty.swap(dirty);
+    return changed;
+}
+
+Region EinkEngine::tileRegion(const std::vector<uint8_t>& tiles) const {
+    // Horizontal runs of set tiles per tile row; Region merges equal runs vertically.
+    Region region;
+    for (size_t ty = 0; ty < mTilesY; ty++) {
+        size_t tx = 0;
+        while (tx < mTilesX) {
+            if (!tiles[ty * mTilesX + tx]) {
+                tx++;
+                continue;
+            }
+            const size_t start = tx;
+            while (tx < mTilesX && tiles[ty * mTilesX + tx]) tx++;
+            region.orSelf(Rect(static_cast<int32_t>(start * kTile),
+                               static_cast<int32_t>(ty * kTile),
+                               static_cast<int32_t>(std::min(tx * kTile, size_t{mWidth})),
+                               static_cast<int32_t>(std::min((ty + 1) * kTile,
+                                                             size_t{mHeight}))));
+        }
+    }
+    return region;
+}
+
+void EinkEngine::markChanged(const Region& region, nsecs_t when) {
+    for (const Rect& r : region) {
+        if (r.isEmpty()) continue;
+        const size_t x0 = static_cast<size_t>(r.left) / kTile;
+        const size_t x1 = static_cast<size_t>(r.right - 1) / kTile;
+        const size_t y0 = static_cast<size_t>(r.top) / kTile;
+        const size_t y1 = static_cast<size_t>(r.bottom - 1) / kTile;
+        for (size_t ty = y0; ty <= y1 && ty < mTilesY; ty++) {
+            for (size_t tx = x0; tx <= x1 && tx < mTilesX; tx++) {
+                nsecs_t& t = mTileChanged[ty * mTilesX + tx];
+                if (t == 0) mPendingClean++;
+                t = when;
+            }
+        }
+    }
+}
+
+void EinkEngine::submit(const Rect& r, uint32_t mode, const char* why, bool countGhost) {
+    drm_eink_update update = {};
+    update.mode = mode;
+    update.left = static_cast<uint32_t>(r.left);
+    update.top = static_cast<uint32_t>(r.top);
+    update.right = static_cast<uint32_t>(r.right - 1);
+    update.bottom = static_cast<uint32_t>(r.bottom - 1);
+    update.fd = mBufferFd;
+    update.format = 0;
+    update.width = mWidth;
+    update.height = mHeight;
+    if (ioctl(mCard, kEinkUpdate, &update) != 0) {
+        ALOGE("EINK_UPDATE mode 0x%x [%d,%d,%d,%d]: %s", mode, r.left, r.top, r.right, r.bottom,
+              strerror(errno));
+        return;
+    }
+    if (mConfig.log) {
+        ALOGI("%s: mode 0x%x [%d,%d,%d,%d] ghost %u", why, mode, r.left, r.top, r.right,
+              r.bottom, mGhost);
+    }
+    if (mConfig.policy < 3) return;
+    // Ghost bookkeeping (policy 3): a GC16 removes the ghosting under it and must be pushed out
+    // of the kernel's last-ten list before A2 works there again (rule 5).
+    const int64_t panel = int64_t{mWidth} * mHeight;
+    if (isGc16(mode)) {
+        mGhost = static_cast<uint32_t>(mGhost - mGhost * area(r) / panel);
+        if (area(r) * 50 > panel) scheduleFlush(systemTime());
+    } else if (countGhost) {
+        mGhost += static_cast<uint32_t>(ghostWeight(mode) * area(r) / panel);
+    }
+}
+
+void EinkEngine::submitRegion(const Region& region, uint32_t mode, size_t maxRects,
+                              const char* why) {
+    if (region.isEmpty()) return;
+    std::vector<Rect> rects(region.begin(), region.end());
+    if (rects.size() > 64) { // scattered changes: the pairwise merge below would be too slow
+        submit(region.getBounds(), mode, why);
+        return;
+    }
+    // Too many updates cost more than they save.
+    reduceRects(&rects, maxRects);
+    for (const Rect& r : rects) submit(r, mode, why);
+}
+
+std::vector<Rect> EinkEngine::regions(const Region& changed) const {
+    // One rectangle per UI element, the way e-readers refresh a widget: changed tiles closer
+    // than merge_px belong together, overlapping boxes merge, and at most max_regions remain.
+    // Never a set of tiles that each refresh on their own.
+    std::vector<Rect> rects(changed.begin(), changed.end());
+    if (rects.size() > 256) return {changed.getBounds()};
+    const int32_t d = mConfig.mergeDist;
+    for (bool merged = true; merged;) {
+        merged = false;
+        for (size_t i = 0; i < rects.size(); i++) {
+            for (size_t j = i + 1; j < rects.size(); j++) {
+                const Rect& a = rects[i];
+                const Rect& b = rects[j];
+                if (a.left < b.right + d && b.left < a.right + d && a.top < b.bottom + d &&
+                    b.top < a.bottom + d) {
+                    rects[i] = unite(a, b);
+                    rects.erase(rects.begin() + static_cast<std::ptrdiff_t>(j));
+                    merged = true;
+                    j = i; // compare the grown rectangle with all others again
+                }
+            }
+        }
+    }
+    reduceRects(&rects, mConfig.maxRegions);
+    return rects;
+}
+
+bool EinkEngine::isGreyRect(const Rect& r, const std::vector<uint8_t>& grey) const {
+    // Grey when at least grey_share percent of the changed tiles in it have greys: one mode for
+    // the whole element, so its parts don't arrive at different times and in different looks.
+    size_t dirty = 0, greyTiles = 0;
+    for (size_t ty = static_cast<size_t>(r.top) / kTile;
+         ty * kTile < static_cast<size_t>(r.bottom) && ty < mTilesY; ty++) {
+        for (size_t tx = static_cast<size_t>(r.left) / kTile;
+             tx * kTile < static_cast<size_t>(r.right) && tx < mTilesX; tx++) {
+            const size_t i = ty * mTilesX + tx;
+            if (i < mDirty.size() && mDirty[i]) dirty++;
+            if (i < grey.size() && grey[i]) greyTiles++;
+        }
+    }
+    return dirty > 0 && greyTiles * 100 >= dirty * std::max(1u, mConfig.greyShare);
+}
+
+void EinkEngine::submitScreen(const Rect& rect, nsecs_t now, const char* why) {
+    const Modes m = modes();
+    const Rect panel(static_cast<int32_t>(mWidth), static_cast<int32_t>(mHeight));
+    if (mConfig.policy >= 3 && mConfig.fullAfter > 0 && mGhost >= mConfig.fullAfter * 1000 &&
+        !isGc16(m.screen)) {
+        // Like an e-reader's page-turn flash: the screen changes anyway, so the one flashing
+        // update that clears the ghosting goes here, over the whole panel.
+        submit(panel, kModeGC16, "screen full (ghost limit)");
+        return;
+    }
+    (void)now;
+    submit(rect, m.screen, why);
+}
+
+bool EinkEngine::takeForcedMode(uint32_t* mode) {
+    if (!mForceProp) mForceProp = __system_property_find("vendor.xrz.force_global_refresh_mode");
+    if (!mForceProp) return false;
+    const uint32_t serial = __system_property_serial(mForceProp);
+    if (serial == mForceSerial) return false;
+    mForceSerial = serial;
+    *mode = readUint(mForceProp, 0);
+    return *mode != 0 && *mode != 0xffffffffu;
+}
+
+uint32_t EinkEngine::frameMode() {
+    if (!mModeProp) mModeProp = __system_property_find("vendor.xrz.global_refresh_mode");
+    const uint32_t appMode = readUint(mModeProp, 0);
+    if (appMode == 0 || appMode == 0xffffffffu) return mConfig.defaultMode;
+    // Policy 1 maps "fast" (A2) to DU, as flashed on 2026-11-13.
+    return appMode == kModeA2 ? kModeDU : appMode;
+}
+
+EinkEngine::Modes EinkEngine::modes() {
+    if (!mModeProp) mModeProp = __system_property_find("vendor.xrz.global_refresh_mode");
+    const uint32_t appMode = readUint(mModeProp, 0);
+    Modes m{mConfig.tapBw, mConfig.tapGrey, mConfig.screenMode, mConfig.motionMode,
+            mConfig.settleMode};
+    switch (appMode) {
+        case 0:
+        case 0xffffffffu:
+            break;
+        case kModeA2: // "Fast": A2 except for new screens and the settle
+            m.bw = m.grey = m.motion = kModeA2;
+            break;
+        case kModeGC16:
+            // "Clear": GC16 for every change. Policy 3 flushes each GC16 out of the kernel's
+            // last-ten list afterwards, so motion can use A2 (otherwise it falls back to GU16).
+            m = {kModeGC16, kModeGC16, kModeGC16, mConfig.policy >= 3 ? kModeA2 : kModeDU,
+                 kModeGC16};
+            break;
+        default: // e.g. GL16: greys and new screens in that mode, black and white in DU
+            m.bw = kModeDU;
+            m.grey = m.screen = appMode;
+            break;
+    }
+    return m;
+}
+
+void EinkEngine::scheduleFlush(nsecs_t now) {
+    mFlushLeft = kFlushUpdates;
+    mFlushNext = now + 500 * 1000 * 1000; // after the GC16 itself (~400 ms)
+    mCondition.notify_one();
+}
+
+void EinkEngine::onFrame(const sp<GraphicBuffer>& buffer, const sp<Fence>& acquireFence,
+                         const Region& damage) {
+    if (!buffer) return;
+    std::lock_guard lock(mMutex);
+    // The vendor composer must commit first: the kernel driver sets up its pipeline on those
+    // commits, and an engine update before that spins in the kernel (seen at boot). Then the
+    // engine takes over and the composer stops its own e-ink commits.
+    if (mFramesSeen < kHandoverFrames) {
+        ++mFramesSeen;
+        return;
+    }
+    const bool firstInit = !mInitDone;
+    if (!init(buffer->getWidth(), buffer->getHeight())) return;
+    if (firstInit) {
+        base::SetProperty("vendor.xrz.disable_commit", "1");
+    }
+    if (mConfig.policy < 2) {
+        // Policy 1 converts here; otherwise only the work thread reloads the configuration,
+        // so the conversion it runs without the lock never sees the LUT change under it.
+        reloadConfigIfChanged();
+        onFrameV1(buffer, acquireFence, damage);
+    } else {
+        onFrameV2(buffer, acquireFence, damage);
+    }
+    mCondition.notify_one();
+}
+
+// ---------------------------------------------------------------------------------------------
+// Policy 2
+
+void EinkEngine::onFrameV2(const sp<GraphicBuffer>& buffer, const sp<Fence>& acquireFence,
+                           const Region& damage) {
+    // SurfaceFlinger's main thread only hands the frame over: reading the client target takes
+    // ~50 ms for a full frame, and doing it here held composition to about ten frames a second.
+    // The work thread converts the newest frame; frames in between are never looked at.
+    const Rect screen(static_cast<int32_t>(mWidth), static_cast<int32_t>(mHeight));
+    const nsecs_t now = systemTime();
+    uint32_t forcedMode = 0;
+    const bool forced = takeForcedMode(&forcedMode);
+    Region region = damage.intersect(screen);
+    if (forced || region.isEmpty() || !mHadFrame) region = Region(screen);
+    mPendingDamage.orSelf(region);
+    mDeferred = buffer;
+    mDeferredFence = acquireFence;
+    mDeferredTime = now;
+    if (forced || !mHadFrame) {
+        // A forced refresh, or the first frame: the whole panel, so the grey buffer and the
+        // panel agree from here on.
+        mForcedPending = true;
+        mForcedMode = forced ? forcedMode : kModeGL16;
+    }
+    if (mMotion) mLastFrame = now;
+}
+
+void EinkEngine::waitUntilReleased(const GraphicBuffer* buffer) {
+    if (!buffer) return;
+    std::unique_lock lock(mMutex);
+    mReadDone.wait(lock, [this, buffer] { return mReading != buffer; });
+}
+
+bool EinkEngine::convertNewest(std::unique_lock<std::mutex>& lock) {
+    // Called with the lock held; converts without it, so SurfaceFlinger never waits for the
+    // conversion unless it is about to give this very buffer back (waitUntilReleased).
+    const sp<GraphicBuffer> buffer = mDeferred;
+    const sp<Fence> fence = mDeferredFence;
+    const Region region = mPendingDamage;
+    const nsecs_t when = mDeferredTime;
+    const bool forced = mForcedPending;
+    const uint32_t forcedMode = mForcedMode;
+    mDeferred.clear();
+    mDeferredFence.clear();
+    mPendingDamage.clear();
+    mForcedPending = false;
+    mReading = buffer.get();
+    lock.unlock();
+    bool ok = true;
+    if (fence && fence->wait(500) != NO_ERROR) {
+        ALOGW("client target fence timeout, skipping frame");
+        ok = false;
+    }
+    std::vector<uint8_t> grey;
+    Region changed;
+    if (ok) changed = convert(buffer, region, forced ? nullptr : &grey);
+    lock.lock();
+    mReading = nullptr;
+    mReadDone.notify_all();
+    if (!ok) {
+        mPendingDamage.orSelf(region); // converted with the next frame
+        if (forced && !mForcedPending) {
+            mForcedPending = true;
+            mForcedMode = forcedMode;
+        }
+        return false;
+    }
+    const nsecs_t now = systemTime();
+    if (forced) {
+        const Rect screen(static_cast<int32_t>(mWidth), static_cast<int32_t>(mHeight));
+        const char* why = mHadFrame ? "forced" : "first";
+        mHadFrame = true;
+        mMotion = false;
+        mSettlePending = false;
+        mGestureValid = false;
+        mScreenPending = false;
+        mStreak = 0;
+        submit(screen, forcedMode, why);
+        if (isGc16(forcedMode)) scheduleFlush(now);
+        if (mConfig.cleanDelay > 0) {
+            std::fill(mTileChanged.begin(), mTileChanged.end(), 0);
+            mPendingClean = 0;
+        }
+        return true;
+    }
+    if (mMotion) {
+        processMotion(changed, now);
+    } else {
+        // Motion and streak timing go by when the frame arrived, not when it was converted.
+        processTap(changed, grey, when);
+    }
+    return true;
+}
+
+void EinkEngine::processTap(const Region& changed, const std::vector<uint8_t>& grey,
+                            nsecs_t now) {
+    if (changed.isEmpty()) return;
+    const Rect bounds = changed.getBounds();
+    const int64_t panel = int64_t{mWidth} * mHeight;
+    if (mScreenPending || (area(bounds) * 2 > panel && mConfig.screenWait > 0)) {
+        // A new screen (over half the panel): collect the frames that draw it, then one update
+        // (workLoop). Changes in the meantime join it.
+        if (!mScreenPending) {
+            mScreenPending = true;
+            mScreenStart = now;
+            mScreen = bounds;
+            mScreenFrames = 1;
+        } else {
+            mScreen = unite(mScreen, bounds);
+            mScreenFrames++;
+        }
+        mLastChange = now;
+        mStreak = 1;
+        if (mConfig.cleanDelay > 0) markChanged(changed, now);
+        if (mScreenFrames >= mConfig.motionFrames && now - mScreenStart >= mConfig.screenWait) {
+            // Still changing frame after frame, for longer than the collection window: a scroll
+            // or a swipe, not a new screen (apps draw a new screen in two or three frames, which
+            // can come 16 ms apart).
+            mScreenPending = false;
+            startMotion(mScreen, now, "motion (from screen)");
+            return;
+        }
+        mScreenDue = std::min(now + mConfig.screenWait, mScreenStart + 3 * mConfig.screenWait);
+        return;
+    }
+    mStreak = now - mLastChange < mConfig.motionGap ? mStreak + 1 : 1;
+    mLastChange = now;
+    const bool big = area(bounds) * kMotionAreaDiv >= panel;
+    const Modes m = modes();
+    if (mStreak >= mConfig.motionFrames || (big && mStreak >= 2)) {
+        // This change starts an animation: from here on, one update per panel slot.
+        startMotion(bounds, now, "motion start");
+        return;
+    }
+    if (mConfig.cleanDelay > 0) markChanged(changed, now);
+    if (mConfig.policy >= 3) {
+        if (area(bounds) * 2 > panel) {
+            submitScreen(bounds, now, "tap screen");
+            return;
+        }
+        // A second change right after the first is probably the start of an animation: the
+        // fast mode, so the next frames don't wait for a slow grey waveform.
+        for (const Rect& r : regions(changed)) {
+            if (mStreak >= 2) {
+                submit(r, m.motion, "tap fast");
+            } else {
+                const bool greyRect = isGreyRect(r, grey);
+                submit(r, greyRect ? m.grey : m.bw, greyRect ? "tap grey" : "tap bw");
+            }
+        }
+        return;
+    }
+    if (mStreak >= 2) {
+        // A second change right after the first: probably the start of an animation, so no
+        // slow grey waveform that the next frames would have to wait for.
+        submitRegion(changed, m.motion, mConfig.maxRects, "tap fast");
+        return;
+    }
+    if (area(bounds) * 2 > panel) {
+        // A new screen: one update, so it doesn't build up in pieces.
+        submit(bounds, m.screen, "tap screen");
+        return;
+    }
+    std::vector<uint8_t> bw(grey.size(), 0);
+    {
+        // Tiles from the conversion are "changed" exactly when tileRegion() includes them.
+        std::vector<uint8_t> dirty(grey.size(), 0);
+        for (const Rect& r : changed) {
+            for (int32_t ty = r.top / int32_t{kTile}; ty * int32_t{kTile} < r.bottom; ty++) {
+                for (int32_t tx = r.left / int32_t{kTile}; tx * int32_t{kTile} < r.right; tx++) {
+                    dirty[static_cast<size_t>(ty) * mTilesX + static_cast<size_t>(tx)] = 1;
+                }
+            }
+        }
+        for (size_t i = 0; i < grey.size(); i++) bw[i] = dirty[i] && !grey[i];
+    }
+    const Region bwRegion = tileRegion(bw);
+    const Region greyRegion = tileRegion(grey);
+    const size_t bwRects = greyRegion.isEmpty() ? mConfig.maxRects
+                                                : std::max<size_t>(1, mConfig.maxRects / 2);
+    const size_t greyRects = bwRegion.isEmpty() ? mConfig.maxRects
+                                                : std::max<size_t>(1, mConfig.maxRects - bwRects);
+    submitRegion(bwRegion, m.bw, bwRects, "tap bw");
+    submitRegion(greyRegion, m.grey, greyRects, "tap grey");
+}
+
+void EinkEngine::startMotion(const Rect& rect, nsecs_t now, const char* why) {
+    const Modes m = modes();
+    mMotion = true;
+    mLastFrame = now;
+    mLastMotionChange = now;
+    mGesture = rect;
+    mGestureValid = true;
+    mGestureFrames = 1;
+    submit(mGesture, m.motion, why, false);
+    mMotionNext = now + mConfig.motionInterval;
+    mLastMotionSubmit = now;
+    mSettlePending = m.settle != 0;
+}
+
+void EinkEngine::processMotion(const Region& changed, nsecs_t now) {
+    if (changed.isEmpty()) return;
+    mLastMotionChange = now;
+    const Rect bounds = changed.getBounds();
+    mGesture = mGestureValid ? unite(mGesture, bounds) : bounds;
+    mGestureValid = true;
+    mGestureFrames++;
+    const Modes m = modes();
+    // The same rectangle every time: an update the kernel has not started yet is replaced by
+    // the newer one instead of being played after it.
+    submit(mGesture, m.motion, "motion", false);
+    mMotionNext = now + mConfig.motionInterval;
+    mLastMotionSubmit = now;
+    mSettlePending = m.settle != 0;
+    if (++mMotionCount == 100) {
+        ALOGI("motion: 100 updates");
+        mMotionCount = 0;
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Policy 1 (as flashed on 2026-11-13)
+
+void EinkEngine::onFrameV1(const sp<GraphicBuffer>& buffer, const sp<Fence>& acquireFence,
+                           const Region& damage) {
+    const Rect screen(static_cast<int32_t>(mWidth), static_cast<int32_t>(mHeight));
+    Region region = damage.intersect(screen);
+    uint32_t mode;
+    const bool forced = takeForcedMode(&mode);
+    if (forced || region.isEmpty() || !mHadFrame) region = Region(screen);
+    if (!forced) mode = frameMode();
+
+    if (acquireFence && acquireFence->wait(500) != NO_ERROR) {
+        ALOGW("client target fence timeout, skipping frame");
+        return;
+    }
+    const Region changed = convert(buffer, region, nullptr);
+    const Region update = (forced || !mHadFrame) ? region : changed;
+    mHadFrame = true;
+    if (update.isEmpty()) return;
+
+    const nsecs_t now = systemTime();
+    const Rect bounds = update.getBounds();
+    const bool big = area(bounds) * kMotionAreaDiv >= int64_t{mWidth} * mHeight;
+    mStreak = now - mLastChange < kMotionGapV1 ? mStreak + 1 : 1;
+    mLastChange = now;
+    if (!forced && (mStreak >= kMotionFramesV1 || (big && mStreak >= 2))) {
+        submit(bounds, kModeDU, "v1 motion");
+        mLastMotion = now;
+    } else {
+        submitRegion(update, mode, kMaxRectsV1, "v1");
+    }
+
+    if (mConfig.cleanDelay <= 0) return;
+    if (!mAutoCleanProp) mAutoCleanProp = __system_property_find("vendor.xrz.auto_clean_enabled");
+    if (readUint(mAutoCleanProp, 1) == 0) return;
+    if (forced && update.getBounds() == screen) {
+        std::fill(mTileChanged.begin(), mTileChanged.end(), 0);
+        mPendingClean = 0;
+    } else {
+        markChanged(update, now);
+    }
+}
+
+nsecs_t EinkEngine::cleanTiles(nsecs_t now) {
+    // Each tile gets a cleanup pass once it alone has been quiet for the clean delay, so a
+    // blinking cursor or a clock doesn't hold back the rest of the screen. When one tile is due,
+    // every tile quiet for at least half the delay joins it. Returns when to look again.
+    if (mPendingClean == 0 || mConfig.cleanDelay <= 0) return 0;
+    nsecs_t oldest = INT64_MAX;
+    for (const nsecs_t t : mTileChanged) {
+        if (t != 0) oldest = std::min(oldest, t);
+    }
+    if (now - oldest < mConfig.cleanDelay) return oldest + mConfig.cleanDelay;
+    // Never clean in the middle of an animation.
+    const nsecs_t lastMotion = mConfig.policy < 2 ? mLastMotion : mLastMotionSubmit;
+    if (mMotion) return now + mConfig.cleanDelay;
+    if (lastMotion != 0 && now - lastMotion < mConfig.cleanDelay) {
+        return lastMotion + mConfig.cleanDelay;
+    }
+    std::vector<uint8_t> due(mTileChanged.size(), 0);
+    size_t dueTiles = 0;
+    for (size_t i = 0; i < mTileChanged.size(); i++) {
+        const nsecs_t t = mTileChanged[i];
+        if (t != 0 && now - t >= mConfig.cleanDelay / 2) {
+            due[i] = 1;
+            mTileChanged[i] = 0;
+            mPendingClean--;
+            dueTiles++;
+        }
+    }
+    const Region region = tileRegion(due);
+    if (mConfig.policy < 2) {
+        // GC16 when the pass covers more than half the panel (removes GL16's faint ghost).
+        const uint32_t mode = dueTiles * 2 > mTileChanged.size() ? kModeGC16 : kModeGL16;
+        if (mLastMotion != 0) {
+            submit(region.getBounds(), mode, "v1 clean");
+            mLastMotion = 0;
+        } else {
+            submitRegion(region, mode, kMaxRectsV1, "v1 clean");
+        }
+    } else {
+        submitRegion(region, kModeGL16, mConfig.maxRects, "clean");
+    }
+    return 0;
+}
+
+// ---------------------------------------------------------------------------------------------
+
+void EinkEngine::workLoop() {
+    std::unique_lock lock(mMutex);
+    for (;;) {
+        reloadConfigIfChanged();
+        nsecs_t now = systemTime();
+        nsecs_t wake = 0; // 0 = nothing scheduled
+        const auto earliest = [&wake](nsecs_t t) {
+            if (t != 0 && (wake == 0 || t < wake)) wake = t;
+        };
+
+        if (mConfig.policy >= 2) {
+            if (mDeferred) {
+                // In motion, the newest frame is converted once the panel slot is free; otherwise
+                // at once. Wait for the GPU without the lock: SurfaceFlinger's main thread takes
+                // it for every frame.
+                if (!mMotion || mForcedPending || now >= mMotionNext) {
+                    convertNewest(lock);
+                    continue;
+                }
+                earliest(mMotionNext);
+            }
+            if (mMotion) {
+                // Motion ends when no frame came for a while, or when frames keep coming but
+                // no longer change anything (a screen that stays awake drawing the same).
+                const bool noFrames = !mDeferred && now - mLastFrame >= mConfig.motionEnd;
+                const bool noChange = now - mLastMotionChange >= mConfig.motionEnd;
+                if (noFrames || noChange) {
+                    mMotion = false;
+                    mStreak = 0;
+                    mLastChange = 0;
+                    if (mDeferred) continue; // converted as a tap
+                } else {
+                    earliest(std::min(mDeferred ? INT64_MAX : mLastFrame + mConfig.motionEnd,
+                                      mLastMotionChange + mConfig.motionEnd));
+                }
+            }
+            if (mSettlePending && !mMotion) {
+                const nsecs_t due = mLastMotionSubmit + mConfig.settleDelay;
+                if (now >= due) {
+                    const Modes m = modes();
+                    const bool deep =
+                            (mConfig.deepFrames > 0 && mGestureFrames >= mConfig.deepFrames) ||
+                            (mConfig.policy >= 3 && mConfig.fullAfter > 0 &&
+                             mGhost >= mConfig.fullAfter * 1000);
+                    if (mGestureValid && m.settle != 0) {
+                        // A gesture's fast frames count once, at twice its area, whatever their
+                        // number; the settle itself counts as usual.
+                        if (mConfig.policy >= 3 && !deep) {
+                            const int64_t panel = int64_t{mWidth} * mHeight;
+                            mGhost += static_cast<uint32_t>(2 * ghostWeight(m.motion) *
+                                                            area(mGesture) / panel);
+                        }
+                        submit(mGesture, deep ? kModeGC16 : m.settle, deep ? "deep" : "settle");
+                        if (deep) scheduleFlush(now);
+                    }
+                    mSettlePending = false;
+                    mGestureValid = false;
+                    mGestureFrames = 0;
+                } else {
+                    earliest(due);
+                }
+            }
+            if (mScreenPending) {
+                if (now >= mScreenDue) {
+                    mScreenPending = false;
+                    if (now - mLastChange < mConfig.screenWait) {
+                        // The cap was reached while it kept changing: an animation.
+                        startMotion(mScreen, now, "motion (from screen)");
+                    } else {
+                        submitScreen(mScreen, now, "screen");
+                    }
+                } else {
+                    earliest(mScreenDue);
+                }
+            }
+            if (mFlushLeft > 0) {
+                if (now >= mFlushNext) {
+                    // An invisible 2x2 update (nothing changed there) in the panel corner.
+                    const int32_t x = static_cast<int32_t>(mWidth) - 4 -
+                            static_cast<int32_t>(mFlushLeft) * 4;
+                    const int32_t y = static_cast<int32_t>(mHeight) - 4;
+                    mFlushLeft--;
+                    submit(Rect(x, y, x + 2, y + 2), kModeDU, "flush");
+                    mFlushNext = now + kFlushSpacing;
+                }
+                if (mFlushLeft > 0) earliest(mFlushNext);
+            }
+        }
+        earliest(cleanTiles(now));
+
+        if (wake == 0) {
+            mCondition.wait(lock);
+        } else if (wake > now) {
+            mCondition.wait_for(lock, std::chrono::nanoseconds(wake - now));
+        }
+    }
+}
+
+} // namespace android
