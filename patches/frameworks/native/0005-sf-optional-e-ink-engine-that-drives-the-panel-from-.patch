+#pragma once
+
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+#include <ui/Fence.h>
+#include <ui/GraphicBuffer.h>
+#include <ui/Region.h>
+#include <utils/Timers.h>
+
+struct prop_info;
+
+namespace android {
+
+/**
+ * Drives an e-ink panel directly from the composed client target (debug.sf.eink_engine=1).
+ *
+ * The vendor composer on the Bigme HiBreak Pro (MT6877, XRZ e-ink kernel driver) refreshes the
+ * whole panel for every frame, so a key press waits for a full-panel waveform. This engine
+ * converts the damaged part of each composed frame to 8-bit grey in a persistent ION buffer,
+ * finds the 32x32 tiles that really changed and submits DRM_IOCTL_EINK_UPDATE for them itself.
+ * Kernel behaviour this relies on is in docs/eink-interface.md ("Update pipeline").
+ *
+ * The frame is converted on the engine's own thread (policies 2 and 3), never on SurfaceFlinger's
+ * main thread: reading a full client target takes ~50 ms, and doing it there held composition to
+ * about ten frames a second. FramebufferSurface waits (waitUntilReleased) only before it gives
+ * back the one buffer that is being read.
+ *
+ * Policy 3 (default) is policy 2 with the update shapes and the ghost handling of e-readers
+ * (Kindle, Kobo and KOReader refresh a widget's or the page's rectangle, never a grid of cells;
+ * docs/eink-vendor-research.md):
+ *  - Regions, not tiles: the 32x32 tile diff only says what changed. Changed tiles closer than
+ *    debug.sf.eink.merge_px form one rectangle (a button, a list row, the status bar), at most
+ *    debug.sf.eink.max_regions of them, and each goes out as ONE update in ONE mode: grey when
+ *    grey_share percent of its changed tiles have greys, otherwise the fast mode. Policy 2 split
+ *    one button into A2 and GL16 tiles that arrived at different times; with the "Clear" app
+ *    mode every tile flashed GC16 on its own.
+ *  - Ghost budget: the fast modes leave ghosts only GC16 removes (rule 8). The engine counts
+ *    them (panels drawn in a fast mode; GL16 counts half; a gesture counts once, at twice its
+ *    area) and, once debug.sf.eink.full_after panels have built up, the next new screen goes
+ *    out as one GC16 of the whole panel, or the next settle as GC16 over its gesture: the
+ *    "full refresh every N pages" of e-readers. GL16 screen changes leave visible ghosts of
+ *    the previous screen with or without the kernel's auto-clean (camera, 2026-11-14).
+ *  - Every large GC16 is followed by the invisible flush, so A2 keeps working after it; the
+ *    "Clear" app mode therefore scrolls in A2 instead of DU.
+ *
+ * Policy 2 (debug.sf.eink.policy=2) sorts every change into one of three classes:
+ *  - Tap: a change with no motion (key press, toggle, new screen). Tiles that are pure black and
+ *    white go out in the fast mode (A2, ~145 ms), tiles with greys in GL16 (~400 ms), as at
+ *    most debug.sf.eink.max_rects rectangles. A change over half the panel (a new screen) is
+ *    one GL16 update, even for apps set to "fast": A2 would leave ghosts of the old screen. A
+ *    second change within the motion gap already uses the fast mode everywhere. No cleanup pass
+ *    follows: the kernel cleans A2 ghosting itself (eink_debug/clean_a2).
+ *  - Motion: changes keep arriving less than the motion gap apart (scrolling, page swipes, the
+ *    shade). One update per panel slot (debug.sf.eink.motion_ms) over one rectangle that only
+ *    grows during the gesture, so the kernel can drop frames it has not started yet; frames
+ *    arriving in between are not even converted, the newest one is converted when the slot is
+ *    free. The panel shows the newest picture about ten times a second instead of replaying a
+ *    backlog.
+ *  - Settle: once, debug.sf.eink.settle_ms after the last motion update, over the gesture
+ *    rectangle in GL16, which restores the greys the 1-bit motion frames dropped.
+ * GC16 is never used automatically: while a GC16 of an area is among the kernel's last ten
+ * updates, A2 there falls back to a dithered GU16 (~365 ms). After a GC16 (the "refresh screen"
+ * tile, or a deep clean) the engine sends ten invisible 2x2 updates to push it out.
+ *
+ * Policy 1 is the earlier behaviour: every change in the app's mode, DU for detected motion,
+ * and a GL16/GC16 cleanup pass per tile debug.sf.eink.clean_ms after it changed.
+ *
+ * The vendor composer commits the first few frames after boot (the kernel driver sets up its
+ * pipeline on those); then the engine sets vendor.xrz.disable_commit and takes over.
+ *
+ * Properties, re-read whenever any property changes (so tuning needs no restart):
+ *   debug.sf.eink_engine          engine on (read at boot only)
+ *   debug.sf.eink.policy          3 (default), 2 or 1
+ *   debug.sf.eink.merge_px        policy 3: changes closer than this are one region (default 96)
+ *   debug.sf.eink.max_regions     policy 3: regions per change (default 2)
+ *   debug.sf.eink.grey_share      policy 3: percent of grey tiles that make a region grey (25)
+ *   debug.sf.eink.full_after      policy 3: ghost budget in panels before a GC16 (default 4
+ *                                 with auto-clean off, 8 with it on; 0 = never)
+ *   debug.sf.eink.tap_bw          tap mode for black/white tiles (default 16, A2)
+ *   debug.sf.eink.tap_grey        tap mode for tiles with greys (default 32, GL16)
+ *   debug.sf.eink.screen_mode     mode for a change over half the panel (default 32, GL16)
+ *   debug.sf.eink.screen_wait_ms  a new screen is sent once no change came for this long (at
+ *                                 most three times as long), so it goes out as one update
+ *                                 although apps draw it in two or three frames (default 120;
+ *                                 frames come about 100 ms apart while the panel is busy)
+ *   debug.sf.eink.grey_px         grey pixels that make a tile "grey" (default 48 of 1024)
+ *   debug.sf.eink.max_rects       rectangles per frame (default 4; the kernel queues 10)
+ *   debug.sf.eink.motion_mode     (default 16, A2)
+ *   debug.sf.eink.motion_ms       minimum time between motion updates (default 90)
+ *   debug.sf.eink.motion_gap_ms   changes closer than this are motion (default 100)
+ *   debug.sf.eink.motion_frames   changes in a row that start motion (default 3)
+ *   debug.sf.eink.motion_end_ms   motion ends this long after the last frame, or the last frame
+ *                                 that changed pixels (default 250; frames slow down to about
+ *                                 100 ms apart while the panel is busy)
+ *   debug.sf.eink.settle_mode     (default 32, GL16; 0 = no settle)
+ *   debug.sf.eink.settle_ms       (default 150)
+ *   debug.sf.eink.deep_frames     settle with GC16 after this many motion updates (0 = never)
+ *   debug.sf.eink.clean_ms        per-tile cleanup delay (policy 1: default 800; policy 2: 0)
+ *   debug.sf.eink.mode            policy 1 default mode (0xb2)
+ *   debug.sf.eink.black / .white  grey levels clamped to black / white (default 48 / 208)
+ *   debug.sf.eink.log             1 = log every decision (tag EinkEngine)
+ *   debug.sf.eink.convert_threads threads that read the client target together (default 4)
+ *   debug.sf.eink.no_hw_fb        1 = client target without GRALLOC_USAGE_HW_FB (read at boot)
+ *   vendor.xrz.global_refresh_mode   per-app mode from HiBreakParts (0 = default, 4 = clear,
+ *                                    32 = GL16, 16 = fast)
+ *   vendor.xrz.force_global_refresh_mode  each write requests one full refresh in that mode
+ *   vendor.xrz.auto_clean_enabled         policy 1 cleanup switch
+ */
+class EinkEngine {
+public:
+    static bool enabled();
+    static EinkEngine& get();
+
+    /** Called for every client target queued to the display, after it was handed to HWC. */
+    void onFrame(const sp<GraphicBuffer>& buffer, const sp<Fence>& acquireFence,
+                 const Region& damage);
+
+    /** Blocks while the engine reads `buffer`. FramebufferSurface calls it before it gives a
+     *  client target back to the queue, so nothing draws into a buffer being converted. */
+    void waitUntilReleased(const GraphicBuffer* buffer);
+
+    /** debug.sf.eink.no_hw_fb: allocate the client target without GRALLOC_USAGE_HW_FB. */
+    static bool clientTargetWithoutFb();
+
+private:
+    struct Config {
+        uint32_t policy = 3;
+        uint32_t defaultMode = 0xb2;
+        nsecs_t cleanDelay = 0;
+        uint32_t tapBw = 16;
+        uint32_t tapGrey = 32;
+        uint32_t screenMode = 32;
+        nsecs_t screenWait = 0;
+        uint32_t greyPixels = 48;
+        uint32_t maxRects = 4;
+        uint32_t motionMode = 16;
+        nsecs_t motionInterval = 0;
+        nsecs_t motionGap = 0;
+        nsecs_t motionEnd = 0;
+        uint32_t motionFrames = 3;
+        uint32_t settleMode = 32;
+        nsecs_t settleDelay = 0;
+        uint32_t deepFrames = 0;
+        int32_t mergeDist = 96;
+        uint32_t maxRegions = 2;
+        uint32_t greyShare = 25;
+        uint32_t fullAfter = 0;
+        bool log = false;
+        uint32_t convertThreads = 4;
+        int black = 48;
+        int white = 208;
+    };
+    struct Modes {
+        uint32_t bw, grey, screen, motion, settle;
+    };
+
+    EinkEngine();
+    void loadConfig();
+    void reloadConfigIfChanged();
+    bool init(uint32_t width, uint32_t height);
+    bool allocate(uint32_t size);
+    Region convert(const sp<GraphicBuffer>& buffer, const Region& region,
+                   std::vector<uint8_t>* greyTiles);
+    bool convertNewest(std::unique_lock<std::mutex>& lock);
+    Region tileRegion(const std::vector<uint8_t>& tiles) const;
+    void markChanged(const Region& region, nsecs_t when);
+    void submit(const Rect& rect, uint32_t mode, const char* why, bool countGhost = true);
+    void submitRegion(const Region& region, uint32_t mode, size_t maxRects, const char* why);
+    uint32_t frameMode();
+    Modes modes();
+    bool takeForcedMode(uint32_t* mode);
+    void scheduleFlush(nsecs_t now);
+    std::vector<Rect> regions(const Region& changed) const;
+    bool isGreyRect(const Rect& r, const std::vector<uint8_t>& grey) const;
+    void submitScreen(const Rect& rect, nsecs_t now, const char* why);
+    void onFrameV1(const sp<GraphicBuffer>& buffer, const sp<Fence>& acquireFence,
+                   const Region& damage);
+    void onFrameV2(const sp<GraphicBuffer>& buffer, const sp<Fence>& acquireFence,
+                   const Region& damage);
+    void processTap(const Region& changed, const std::vector<uint8_t>& grey, nsecs_t now);
+    void processMotion(const Region& changed, nsecs_t now);
+    void startMotion(const Rect& rect, nsecs_t now, const char* why);
+    nsecs_t cleanTiles(nsecs_t now);
+    void workLoop();
+
+    bool mInitDone = false;
+    bool mInitFailed = false;
+    bool mHadFrame = false;
+    uint32_t mFramesSeen = 0;
+    int mCard = -1;
+    int mBufferFd = -1;
+    uint8_t* mGrey = nullptr;
+    uint32_t mWidth = 0;
+    uint32_t mHeight = 0;
+    uint8_t mLut[256];
+    std::vector<uint8_t> mShadow; // cached copy of mGrey
+    std::vector<uint16_t> mGreyCount; // per tile, grey pixels in the last conversion
+    std::vector<uint8_t> mDirty;      // per tile, changed in the last conversion
+    uint32_t mConvertCount = 0;
+    nsecs_t mConvertTotal = 0;
+    nsecs_t mConvertMax = 0;
+
+    Config mConfig;
+    uint32_t mPropSerial = 0;
+    const prop_info* mModeProp = nullptr;
+    const prop_info* mForceProp = nullptr;
+    const prop_info* mAutoCleanProp = nullptr;
+    uint32_t mForceSerial = 0;
+
+    std::mutex mMutex; // guards everything below and the ioctl
+    std::condition_variable mCondition;
+    size_t mTilesX = 0;
+    size_t mTilesY = 0;
+    std::vector<nsecs_t> mTileChanged; // last change per tile, 0 = clean (cleanup pass)
+    size_t mPendingClean = 0;          // tiles with a non-zero entry
+    nsecs_t mLastChange = 0;           // last frame that changed the panel
+    uint32_t mStreak = 0;              // consecutive changes less than the motion gap apart
+    nsecs_t mLastMotion = 0;           // policy 1: last frame sent as motion
+    uint32_t mMotionCount = 0;         // stats: motion updates since the last log line
+
+    // Policy 2.
+    sp<GraphicBuffer> mDeferred; // newest client target not converted yet
+    sp<Fence> mDeferredFence;
+    Region mPendingDamage;       // damage of all frames since the last conversion
+    nsecs_t mDeferredTime = 0;   // when mDeferred arrived
+    bool mForcedPending = false; // the next conversion is a forced (or the first) full refresh
+    uint32_t mForcedMode = 0;
+    const GraphicBuffer* mReading = nullptr; // being converted by the work thread
+    std::condition_variable mReadDone;
+    bool mMotion = false;
+    nsecs_t mLastFrame = 0;      // last frame while in motion
+    nsecs_t mLastMotionChange = 0; // last motion conversion that changed pixels
+    nsecs_t mMotionNext = 0;     // the next motion update may go out from here
+    nsecs_t mLastMotionSubmit = 0;
+    Rect mGesture;               // grows during a gesture, reset by the settle update
+    bool mGestureValid = false;
+    uint32_t mGestureFrames = 0;
+    bool mSettlePending = false;
+    bool mScreenPending = false; // a new screen is being collected
+    Rect mScreen;
+    nsecs_t mScreenStart = 0;
+    nsecs_t mScreenDue = 0;
+    uint32_t mScreenFrames = 0;
+    uint32_t mGhost = 0;         // policy 3: ghosting built up, thousandths of a panel
+    uint32_t mFlushLeft = 0;     // invisible updates still to send after a GC16
+    nsecs_t mFlushNext = 0;
+};
+
+} // namespace android
