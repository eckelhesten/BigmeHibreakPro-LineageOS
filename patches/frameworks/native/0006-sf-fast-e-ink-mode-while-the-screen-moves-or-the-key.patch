+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <thread>
+
+#include <sys/system_properties.h>
+#include <utils/Timers.h>
+
+namespace android {
+
+// Fast e-ink mode while the screen moves or the keyboard is up, for the XRZ e-ink composer
+// (Bigme HiBreak Pro). The composer takes its refresh mode from vendor.xrz.global_refresh_mode
+// on every commit. NORMAL (DU) shows a frame every ~120 ms, FAST (A2) every ~36 ms, both on the
+// kernel's self-cleaning path. This class switches the property to FAST while frames arrive in a
+// row or while the input method is visible, then puts the previous mode back and asks for one
+// repaint, so the still screen is drawn in the mode the user chose.
+class EinkMotion {
+public:
+    // debug.sf.eink_motion, read once.
+    static bool enabled();
+    static EinkMotion& get();
+
+    // Called once, with a thread-safe function that makes SurfaceFlinger composite again.
+    void setRepaint(std::function<void()> repaint);
+
+    // Called on the main thread for every composite, before it is presented.
+    void onComposite(bool imeVisible);
+
+private:
+    EinkMotion() = default;
+
+    struct Config {
+        bool motion = true;      // vendor.xrz.hibreak_motion_fast
+        bool ime = true;         // vendor.xrz.hibreak_ime_fast
+        uint32_t fastMode = 0xb3; // debug.sf.eink_motion.mode
+        uint32_t frames = 3;     // debug.sf.eink_motion.frames
+        nsecs_t gap = 0;         // debug.sf.eink_motion.gap_ms
+        nsecs_t end = 0;         // debug.sf.eink_motion.end_ms
+    };
+
+    void reloadConfigIfChanged();
+    uint32_t readMode();
+    void writeMode(uint32_t mode);
+    bool isFast(uint32_t mode) const;
+    void threadLoop();
+
+    std::mutex mMutex;
+    std::condition_variable mCondition;
+    bool mStarted = false;
+    std::function<void()> mRepaint;
+    Config mConfig;
+    uint32_t mPropSerial = 0xffffffffu;
+    const prop_info* mModeProp = nullptr;
+
+    nsecs_t mLastFrame = 0;
+    uint32_t mStreak = 0;
+    bool mImeVisible = false;
+    bool mFast = false;    // the property holds our fast mode
+    uint32_t mBase = 0;    // the mode to put back
+    uint32_t mWritten = 0; // what we wrote, to notice when someone else changes the mode
+};
+
+} // namespace android
diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index d1dcc3d..7c7fe7d 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -137,6 +137,7 @@
 #include "Display/DisplayIdentification.h"
 #include "DisplayDevice.h"
 #include "DisplayHardware/ComposerHal.h"
+#include "DisplayHardware/EinkMotion.h"
 #include "DisplayHardware/FramebufferSurface.h"
 #include "DisplayHardware/Hal.h"
 #include "DisplayHardware/VirtualDisplay/LegacyVirtualDisplaySurface.h"
@@ -949,6 +950,10 @@ void SurfaceFlinger::init() FTL_FAKE_GUARD(kMainThreadContext) {
           "Initializing graphics H/W...");
     addTransactionReadyFilters();
     mTransactionHandler.setTransactionBarrierTtl(std::chrono::seconds(5));
+    if (EinkMotion::enabled()) {
+        // E-ink: a fast refresh mode while the screen moves; scheduleRepaint is thread-safe.
+        EinkMotion::get().setRepaint([this] { scheduleRepaint(); });
+    }
     Mutex::Autolock lock(mStateLock);
 
     // Get a RenderEngine for the given display / config (can't fail)
@@ -3245,6 +3250,23 @@ CompositeResultsPerDisplay SurfaceFlinger::composite(
                                              offloadedLayers);
     }
 
+    if (EinkMotion::enabled()) {
+        // E-ink: tell the motion detector about this frame before the composer commits it, and
+        // whether the input method is on screen (its buffer layer is named "InputMethod#<id>").
+        // The snapshots are held by the layers' front ends while a frame is composited, not by
+        // mLayerSnapshotBuilder.
+        bool imeVisible = false;
+        for (const auto& [layer, layerFE] : layers) {
+            const auto& snapshot = layerFE->mSnapshot;
+            if (snapshot && snapshot->isVisible &&
+                snapshot->name.find("InputMethod#") != std::string::npos) {
+                imeVisible = true;
+                break;
+            }
+        }
+        EinkMotion::get().onComposite(imeVisible);
+    }
+
     mCompositionEngine->present(mainThreadRefreshArgs);
 
     finalizeReadback(mainThreadRefreshArgs.outputs);
