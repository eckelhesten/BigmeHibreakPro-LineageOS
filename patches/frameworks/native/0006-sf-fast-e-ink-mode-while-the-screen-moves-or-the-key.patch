diff --git a/services/surfaceflinger/DisplayHardware/EinkMotion.cpp b/services/surfaceflinger/DisplayHardware/EinkMotion.cpp
new file mode 100644
index 0000000..a50f3ce
--- /dev/null
+++ b/services/surfaceflinger/DisplayHardware/EinkMotion.cpp
@@ -0,0 +1,161 @@
+/*
+ * Copyright (C) 2026 The LineageOS Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#undef LOG_TAG
+#define LOG_TAG "EinkMotion"
+
+#include "EinkMotion.h"
+
+#include <android-base/properties.h>
+#include <log/log.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <string>
+
+namespace android {
+namespace {
+
+constexpr char kModeProperty[] = "vendor.xrz.global_refresh_mode";
+
+uint32_t readUint(const prop_info* pi, uint32_t fallback) {
+    if (!pi) return fallback;
+    uint32_t value = fallback;
+    __system_property_read_callback(
+            pi,
+            [](void* cookie, const char*, const char* v, uint32_t) {
+                char* end = nullptr;
+                const unsigned long parsed = strtoul(v, &end, 0);
+                if (end != v) *static_cast<uint32_t*>(cookie) = static_cast<uint32_t>(parsed);
+            },
+            &value);
+    return value;
+}
+
+} // namespace
+
+bool EinkMotion::enabled() {
+    static const bool sEnabled = base::GetBoolProperty("debug.sf.eink_motion", false);
+    return sEnabled;
+}
+
+EinkMotion& EinkMotion::get() {
+    static EinkMotion sInstance;
+    return sInstance;
+}
+
+void EinkMotion::setRepaint(std::function<void()> repaint) {
+    std::lock_guard lock(mMutex);
+    mRepaint = std::move(repaint);
+    if (!mStarted) {
+        mStarted = true;
+        std::thread([this] { threadLoop(); }).detach(); // lives as long as SurfaceFlinger
+    }
+}
+
+void EinkMotion::reloadConfigIfChanged() {
+    // The global serial changes with every property write anywhere; reloading is cheap.
+    const uint32_t serial = __system_property_area_serial();
+    if (serial == mPropSerial) return;
+    mPropSerial = serial;
+    Config c;
+    c.motion = base::GetBoolProperty("vendor.xrz.hibreak_motion_fast", true);
+    c.ime = base::GetBoolProperty("vendor.xrz.hibreak_ime_fast", true);
+    c.fastMode = base::GetUintProperty<uint32_t>("debug.sf.eink_motion.mode", 0xb3);
+    c.frames = std::max(2u, base::GetUintProperty<uint32_t>("debug.sf.eink_motion.frames", 3));
+    c.gap = ms2ns(base::GetUintProperty<uint32_t>("debug.sf.eink_motion.gap_ms", 150));
+    // The kernel cleans up after the last FAST frame in passes that take ~600 ms; a mode change
+    // before they finish cancels them and leaves ghosts.
+    c.end = ms2ns(base::GetUintProperty<uint32_t>("debug.sf.eink_motion.end_ms", 700));
+    mConfig = c;
+}
+
+uint32_t EinkMotion::readMode() {
+    if (!mModeProp) mModeProp = __system_property_find(kModeProperty);
+    const uint32_t mode = readUint(mModeProp, 0);
+    return mode == 0xffffffffu ? 0 : mode;
+}
+
+void EinkMotion::writeMode(uint32_t mode) {
+    base::SetProperty(kModeProperty, std::to_string(mode));
+}
+
+bool EinkMotion::isFast(uint32_t mode) const {
+    // FAST as a policy mode, or A2 as a raw waveform (with and without the cleanup bit).
+    const uint32_t m = mode & 0xff;
+    return m == (mConfig.fastMode & 0xff) || m == 0xb3 || m == 0x10 || m == 0x11;
+}
+
+void EinkMotion::onComposite(bool imeVisible) {
+    std::lock_guard lock(mMutex);
+    reloadConfigIfChanged();
+    const nsecs_t now = systemTime();
+    mStreak = (mLastFrame != 0 && now - mLastFrame <= mConfig.gap) ? mStreak + 1 : 1;
+    mLastFrame = now;
+    mImeVisible = imeVisible;
+
+    const bool wantFast = (mConfig.motion && mStreak >= mConfig.frames) ||
+            (mConfig.ime && imeVisible);
+    const uint32_t current = readMode();
+    if (mFast && current != mWritten) {
+        // Someone else changed the mode meanwhile (e.g. another app came to the front): that is
+        // the mode to go back to.
+        mBase = current;
+        mFast = false;
+    }
+    if (wantFast && !mFast && !isFast(current)) {
+        mBase = current;
+        mWritten = mConfig.fastMode;
+        writeMode(mWritten);
+        mFast = true;
+    }
+    // The thread ends the fast mode once the frames stop.
+    if (mFast) mCondition.notify_one();
+}
+
+void EinkMotion::threadLoop() {
+    std::unique_lock lock(mMutex);
+    while (true) {
+        if (!mFast) {
+            mCondition.wait(lock);
+            continue;
+        }
+        const nsecs_t now = systemTime();
+        const nsecs_t due = mLastFrame + mConfig.end;
+        const bool held = mConfig.ime && mImeVisible;
+        if (held) {
+            // The keyboard is up; onComposite wakes us when that changes.
+            mCondition.wait(lock);
+            continue;
+        }
+        if (now < due) {
+            mCondition.wait_for(lock, std::chrono::nanoseconds(due - now));
+            continue;
+        }
+        // The screen is still: back to the user's mode, and one repaint in it.
+        if (readMode() == mWritten) writeMode(mBase);
+        mFast = false;
+        mStreak = 0;
+        mLastFrame = 0; // the repaint must not count as motion
+        const auto repaint = mRepaint;
+        lock.unlock();
+        if (repaint) repaint();
+        lock.lock();
+    }
+}
+
+} // namespace android
