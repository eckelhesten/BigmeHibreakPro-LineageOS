diff --git a/libs/renderengine/skia/SkiaRenderEngine.cpp b/libs/renderengine/skia/SkiaRenderEngine.cpp
index daa0ecc..e54bd37 100644
--- a/libs/renderengine/skia/SkiaRenderEngine.cpp
+++ b/libs/renderengine/skia/SkiaRenderEngine.cpp
@@ -780,6 +780,61 @@ private:
     AutoBackendTexture::CleanupManager& mMgr;
 };
 
+// E-ink enhancement, see DisplaySettings::einkEnhanceStrength. One pass over the composed frame.
+static const char* const kEinkEnhanceSkSL = R"(
+    uniform shader img;
+    uniform float r;
+    uniform float t1;
+    uniform float t2;
+    uniform float strength;
+    uniform float black;
+    uniform float white;
+    const half3 W = half3(0.299, 0.587, 0.114);
+    half luma(float2 p) { return dot(img.eval(p).rgb, W); }
+    half4 main(float2 xy) {
+        half4 c = img.eval(xy);
+        half l = dot(c.rgb, W);
+        half m = luma(xy + r * float2(1.0, 0.0)) + luma(xy + r * float2(0.5, 0.866)) +
+                 luma(xy + r * float2(-0.5, 0.866)) + luma(xy + r * float2(-1.0, 0.0)) +
+                 luma(xy + r * float2(-0.5, -0.866)) + luma(xy + r * float2(0.5, -0.866)) +
+                 luma(xy + r * float2(1.732, 1.0)) + luma(xy + r * float2(0.0, 2.0)) +
+                 luma(xy + r * float2(-1.732, 1.0)) + luma(xy + r * float2(-1.732, -1.0)) +
+                 luma(xy + r * float2(0.0, -2.0)) + luma(xy + r * float2(1.732, -1.0));
+        half d = l - m / 12.0;
+        half s = smoothstep(t1, t2, abs(d)) * strength;
+        half e = mix(l, d < 0.0 ? 0.0 : 1.0, s);
+        return half4(saturate((c.rgb + (e - l) - black) / (white - black)), c.a);
+    }
+)";
+
+void SkiaRenderEngine::drawEinkEnhance(const DisplaySettings& display,
+                                       const sk_sp<SkSurface>& surface, SkCanvas* canvas) {
+    SFTRACE_CALL();
+    static const sk_sp<SkRuntimeEffect> sEffect = [] {
+        auto [effect, error] = SkRuntimeEffect::MakeForShader(SkString(kEinkEnhanceSkSL));
+        if (!effect) ALOGE("e-ink enhance shader: %s", error.c_str());
+        return effect;
+    }();
+    if (!sEffect) return;
+    sk_sp<SkImage> frame = surface->makeImageSnapshot();
+    if (!frame) return;
+    SkRuntimeShaderBuilder builder(sEffect);
+    builder.child("img") = frame->makeShader(SkTileMode::kClamp, SkTileMode::kClamp,
+                                             SkSamplingOptions(SkFilterMode::kNearest));
+    builder.uniform("r") = display.einkEnhanceRadius;
+    builder.uniform("t1") = display.einkEnhanceT1;
+    builder.uniform("t2") = std::max(display.einkEnhanceT2, display.einkEnhanceT1 + 0.001f);
+    builder.uniform("strength") = std::min(display.einkEnhanceStrength, 1.f);
+    builder.uniform("black") = display.einkBlack;
+    builder.uniform("white") = std::max(display.einkWhite, display.einkBlack + 0.01f);
+    SkPaint paint;
+    paint.setShader(builder.makeShader());
+    paint.setBlendMode(SkBlendMode::kSrc);
+    SkAutoCanvasRestore restore(canvas, true);
+    canvas->resetMatrix();
+    canvas->drawPaint(paint);
+}
+
 void SkiaRenderEngine::drawLayersInternal(
         const std::shared_ptr<std::promise<FenceResult>>&& resultPromise,
         const DisplaySettings& display, const std::vector<LayerSettings>& layers,
@@ -1352,6 +1407,11 @@ void SkiaRenderEngine::drawLayersInternal(
     }
 
     surfaceAutoSaveRestore.restore();
+
+    if (display.einkPass()) {
+        drawEinkEnhance(display, dstSurface, dstCanvas);
+    }
+
     mCapture->endCapture();
 
     LOG_ALWAYS_FATAL_IF(activeSurface != dstSurface);
