+namespace {
+
+// E-ink enhancement and contrast (renderengine::DisplaySettings::einkEnhanceStrength), from
+// properties so they can be tuned on the device: debug.sf.eink_enhance (strength in percent, 0 = off) and
+// debug.sf.eink_enhance.{radius_x10,t1_x1000,t2_x1000}. Only while the composer's refresh mode
+// is a black-and-white one (NORMAL, FAST): the grey modes show anti-aliased edges as they are.
+struct EinkEnhance {
+    float strength = 0.f;
+    float radius = 2.f;
+    float t1 = 0.03f;
+    float t2 = 0.14f;
+    // Text contrast, set by the HiBreakParts app: grey levels (0-255) that become black and
+    // white (vendor.xrz.hibreak_contrast_black / _white).
+    float black = 0.f;
+    float white = 1.f;
+};
+
+EinkEnhance getEinkEnhance() {
+    static std::mutex sMutex;
+    static uint32_t sSerial = 0xffffffffu;
+    static EinkEnhance sConfig;
+    std::lock_guard lock(sMutex);
+    const uint32_t serial = __system_property_area_serial();
+    if (serial != sSerial) {
+        sSerial = serial;
+        EinkEnhance c;
+        const uint32_t mode =
+                base::GetUintProperty<uint32_t>("vendor.xrz.global_refresh_mode", 0u) & 0xff;
+        const bool blackAndWhite = mode == 0 || mode == 0xb2 || mode == 0xb3 || mode == 0x02 ||
+                mode == 0x10 || mode == 0x11;
+        if (blackAndWhite) {
+            c.strength = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance", 0u) / 100.f;
+        }
+        c.radius = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.radius_x10", 20u) / 10.f;
+        c.t1 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.t1_x1000", 30u) / 1000.f;
+        c.t2 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.t2_x1000", 140u) / 1000.f;
+        c.black = std::min(120u, base::GetUintProperty<uint32_t>(
+                                         "vendor.xrz.hibreak_contrast_black", 0u)) / 255.f;
+        c.white = std::max(135u, std::min(255u, base::GetUintProperty<uint32_t>(
+                                                        "vendor.xrz.hibreak_contrast_white",
+                                                        255u))) / 255.f;
+        sConfig = c;
+    }
+    return sConfig;
+}
+
+} // namespace
+
 renderengine::DisplaySettings Output::generateClientCompositionDisplaySettings(
         const std::shared_ptr<renderengine::ExternalTexture>& buffer) const {
     const auto& outputState = getState();
@@ -1547,9 +1597,24 @@ renderengine::DisplaySettings Output::generateClientCompositionDisplaySettings(
     clientCompositionDisplay.colorTransform = outputState.colorTransformMatrix;
     clientCompositionDisplay.deviceHandlesColorTransform =
             outputState.usesDeviceComposition || getSkipColorTransform();
+
+    // E-ink: only for the built-in panel, not for virtual displays (recordings, mirroring).
+    if (getDisplayIdVariant().and_then(asPhysicalDisplayId)) {
+        applyEinkEnhance(clientCompositionDisplay);
+    }
     return clientCompositionDisplay;
 }
 
+void Output::applyEinkEnhance(renderengine::DisplaySettings& settings) {
+    const EinkEnhance eink = getEinkEnhance();
+    settings.einkEnhanceStrength = eink.strength;
+    settings.einkEnhanceRadius = eink.radius;
+    settings.einkEnhanceT1 = eink.t1;
+    settings.einkEnhanceT2 = eink.t2;
+    settings.einkBlack = eink.black;
+    settings.einkWhite = eink.white;
+}
