 libs/renderengine/skia/SkiaRenderEngine.cpp   | 60 +++++++++++++++++
 libs/renderengine/skia/SkiaRenderEngine.h     |  2 +
 .../include/compositionengine/impl/Output.h   |  2 +
 .../CompositionEngine/src/Output.cpp          | 65 +++++++++++++++++++
 .../surfaceflinger/ScreenCaptureOutput.cpp    | 12 ++++
