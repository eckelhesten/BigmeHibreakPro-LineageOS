+    float gate0 = 0.55f;
+    float gate1 = 0.80f;
     // Text contrast, set by the HiBreakParts app: grey levels (0-255) that become black and
     // white (vendor.xrz.hibreak_contrast_black / _white).
     float black = 0.f;
@@ -1547,10 +1552,24 @@ EinkEnhance getEinkEnhance() {
                 mode == 0x10 || mode == 0x11;
         if (blackAndWhite) {
             c.strength = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance", 0u) / 100.f;
+            // FAST (0xb3) is also the motion mode: debug.sf.eink_enhance.fast=0 leaves the pass
+            // out while the screen moves, for a shorter composition (the repaint in the normal
+            // mode at the end of the motion has it again).
+            if (mode == 0xb3 && !base::GetBoolProperty("debug.sf.eink_enhance.fast", true)) {
+                c.strength = 0.f;
+            }
         }
-        c.radius = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.radius_x10", 20u) / 10.f;
-        c.t1 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.t1_x1000", 30u) / 1000.f;
-        c.t2 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.t2_x1000", 140u) / 1000.f;
+        c.radius = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.radius_x10", 35u) / 10.f;
+        c.t1 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.t1_x1000", 40u) / 1000.f;
