 // is a black-and-white one (NORMAL, FAST): the grey modes show anti-aliased edges as they are.
 struct EinkEnhance {
     float strength = 0.f;
-    float radius = 2.f;
-    float t1 = 0.03f;
-    float t2 = 0.14f;
+    float radius = 3.5f;
+    float t1 = 0.04f;
+    float t2 = 0.12f;
