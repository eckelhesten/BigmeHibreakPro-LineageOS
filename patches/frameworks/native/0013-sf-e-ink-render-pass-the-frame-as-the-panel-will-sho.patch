@@ -93,8 +93,45 @@ struct DisplaySettings {
     float einkBlack = 0.f;
     float einkWhite = 1.f;
 
+    // E-ink render pass (einkRender = 3, replaces the enhancement above): the frame is turned
+    // into exactly what the panel shows, so the kernel's own dither has nothing left to do and
+    // passes it unchanged (docs/lessons-learned.md).
+    // - einkMode 0 (NORMAL): anti-aliased edges snap to the local extremes; thin strokes
+    //   (pixels whose surroundings out to 3 * einkEnhanceRadius are mostly on the other side
+    //   of the local mid level, einkMinority0/1) go to pure black or white, so text of any grey
+    //   or weight is solid while wide fills keep their tone; low-contrast steps between light
+    //   flat tones (cards, fields, separators: range einkContour0 to einkContourMax, light side
+    //   from einkContourLight) become a 1-px line, dotted below einkContourSolid; then the tone
+    //   curve and an ordered blue-noise dither to pure black and white.
+    // - einkMode 1 (FAST, motion): tone curve and dither only, cheap, still pure black and
+    //   white (the A2 waveform isn't dithered by the kernel: greys would become partial drives).
+    // - einkMode 2 (HD, CLEAN): 16 levels, 16 * level + 4, ordered dither between levels.
+    // einkMinTone: strokes lighter than this keep their tone instead (1 = every stroke solid; e.g.
+    // 0.35 leaves links of web pages grey). einkKnock: a dithered fill pixel touching a light
+    // label becomes white, so white text on grey or coloured buttons gets a clear 1-px margin.
+    // einkInvert: the frame's lightness is inverted first (per app, for apps that are always dark).
+    // Tone curve: (luma - 0.04) / 0.92, light greys from einkBleach up go to white (1 = off),
+    // greys below einkCrush to black (0 = off), then to the power einkGamma (einkGamma16 in
+    // mode 2): the panel's dot gain makes dithered greys darker than their share of white.
+    int32_t einkRender = 0;
+    int32_t einkMode = 0;
+    float einkMinority0 = 0.50f;
+    float einkMinority1 = 0.65f;
+    float einkMinSpread = 0.25f;
+    float einkContour0 = 0.03f;
+    float einkContourMax = 0.32f;
+    float einkContourLight = 0.75f;
+    float einkContourSolid = 0.10f;
+    float einkBleach = 0.76f;
+    float einkCrush = 0.36f;
+    float einkGamma = 1.25f;
+    float einkGamma16 = 1.25f;
+    float einkMinTone = 1.f;
+    bool einkKnock = true;
+    bool einkInvert = false;
+
     bool einkPass() const {
-        return einkEnhanceStrength > 0.f || einkBlack > 0.f || einkWhite < 1.f;
+        return einkRender >= 3 || einkEnhanceStrength > 0.f || einkBlack > 0.f || einkWhite < 1.f;
     }
 
     // An additional orientation flag to be applied after clipping the output.
@@ -151,7 +188,16 @@ static inline bool operator==(const DisplaySettings& lhs, const DisplaySettings&
             lhs.einkEnhanceT1 == rhs.einkEnhanceT1 && lhs.einkEnhanceT2 == rhs.einkEnhanceT2 &&
             lhs.einkSolid1 == rhs.einkSolid1 && lhs.einkSolid2 == rhs.einkSolid2 &&
             lhs.einkGate0 == rhs.einkGate0 && lhs.einkGate1 == rhs.einkGate1 &&
-            lhs.einkBlack == rhs.einkBlack && lhs.einkWhite == rhs.einkWhite;
+            lhs.einkBlack == rhs.einkBlack && lhs.einkWhite == rhs.einkWhite &&
+            lhs.einkRender == rhs.einkRender && lhs.einkMode == rhs.einkMode &&
+            lhs.einkMinority0 == rhs.einkMinority0 && lhs.einkMinority1 == rhs.einkMinority1 &&
+            lhs.einkMinSpread == rhs.einkMinSpread && lhs.einkContour0 == rhs.einkContour0 &&
+            lhs.einkContourMax == rhs.einkContourMax &&
+            lhs.einkContourLight == rhs.einkContourLight &&
+            lhs.einkContourSolid == rhs.einkContourSolid && lhs.einkBleach == rhs.einkBleach &&
+            lhs.einkCrush == rhs.einkCrush && lhs.einkGamma == rhs.einkGamma &&
+            lhs.einkGamma16 == rhs.einkGamma16 && lhs.einkMinTone == rhs.einkMinTone &&
+            lhs.einkKnock == rhs.einkKnock && lhs.einkInvert == rhs.einkInvert;
 }
 
