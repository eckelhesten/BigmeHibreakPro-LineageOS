+// E-ink render pass, see DisplaySettings::einkRender. One pass over the composed frame; its
+// output is exactly what the panel shows (pure black/white, or 16 levels in einkMode 2).
+// Split into three specialized SkRuntimeEffects (full NORMAL/IME, cheap FAST scroll, 16-level HD)
+// so Mali-G68 doesn't carry the full pass's register footprint while scrolling.
+// Prototype and scores: scripts/eink-bench (variants.py render_v3).
+static const char* const kEinkRenderSkSL = R"(
+    uniform shader img;
+    uniform shader noise;
+    uniform float r;
+    uniform float t1;
+    uniform float t2;
+    uniform float g0;
+    uniform float g1;
+    uniform float m0;
+    uniform float m1;
+    uniform float ms;
+    uniform float c0;
+    uniform float cmax;
+    uniform float clight;
+    uniform float csolid;
+    uniform float bleach;
+    uniform float crush;
+    uniform float gamma;
+    uniform float strength;
+    uniform float mtone;
+    uniform float knock;
+    uniform float invert;
+    const half3 W = half3(0.299, 0.587, 0.114);
+    half luma(float2 p) {
+        half v = dot(img.eval(p).rgb, W);
+        return invert > 0.5 ? 1.0 - v : v;  // per-app inversion for apps that are always dark
+    }
+    half onSide(half t, half lo, half hi, half e) {
+        return (t - lo <= e || hi - t <= e) ? 1.0 : 0.0;
+    }
+    half other(half t, half mid, bool dark) {
+        return dark ? (t > mid ? 1.0 : 0.0) : (t < mid ? 1.0 : 0.0);
+    }
+    half tone(half y) {
+        half t = saturate((y - 0.04) / 0.92);
+        if (bleach < 1.0) {
+            t = mix(t, 1.0, smoothstep(bleach, bleach + 0.10, y));
+        }
+        if (crush > 0.0) {
+            t *= smoothstep(crush * 0.6, crush, y);
+        }
+        return t <= 0.0 ? 0.0 : pow(t, gamma);
+    }
+    half4 main(float2 xy) {
+        half l = luma(xy);
+        // the map holds round(rank / 16) as 0..255: thresholds strictly inside (0, 1)
+        half th = (noise.eval(xy).r * 255.0 + 0.5) / 256.0;
+        half a0 = luma(xy + r * float2(1.0, 0.0));
+        half a1 = luma(xy + r * float2(0.5, 0.866));
+        half a2 = luma(xy + r * float2(-0.5, 0.866));
+        half a3 = luma(xy + r * float2(-1.0, 0.0));
+        half a4 = luma(xy + r * float2(-0.5, -0.866));
+        half a5 = luma(xy + r * float2(0.5, -0.866));
+        half b0 = luma(xy + r * float2(1.732, 1.0));
+        half b1 = luma(xy + r * float2(0.0, 2.0));
+        half b2 = luma(xy + r * float2(-1.732, 1.0));
+        half b3 = luma(xy + r * float2(-1.732, -1.0));
+        half b4 = luma(xy + r * float2(0.0, -2.0));
+        half b5 = luma(xy + r * float2(1.732, -1.0));
+        half lo = min(min(min(min(a0, a1), min(a2, a3)), min(min(a4, a5), min(b0, b1))), min(min(min(b2, b3), min(b4, b5)), l));
+        half hi = max(max(max(max(a0, a1), max(a2, a3)), max(max(a4, a5), max(b0, b1))), max(max(max(b2, b3), max(b4, b5)), l));
+        half spread = hi - lo;
+        half mid = 0.5 * (lo + hi);
+        half e = 0.25 * spread;
+        half n = 1.0 + onSide(a0, lo, hi, e) + onSide(a1, lo, hi, e) + onSide(a2, lo, hi, e) +
+                   onSide(a3, lo, hi, e) + onSide(a4, lo, hi, e) + onSide(a5, lo, hi, e) +
+                   onSide(b0, lo, hi, e) + onSide(b1, lo, hi, e) + onSide(b2, lo, hi, e) +
+                   onSide(b3, lo, hi, e) + onSide(b4, lo, hi, e) + onSide(b5, lo, hi, e);
+        half gate = g1 > 0.0 ? smoothstep(g0, g1, n / 13.0) : 1.0;
+        bool dark = l < mid;
+        // anti-aliased edges to the nearer local extreme
+        half s = smoothstep(t1, t2, spread) * gate * strength;
+        half y = mix(l, dark ? lo : hi, s);
+        // thin strokes (mostly surrounded by the other side) to pure black or white;
+        // skip the 6 outer-ring fetches on flat/photo pixels where push is guaranteed 0
+        half push = 0.0;
+        if (spread > ms * 0.6 && gate > 0.0 && !(dark && lo > mtone)) {
+            half k0 = luma(xy + r * float2(2.598, 1.5));
+            half k1 = luma(xy + r * float2(0.0, 3.0));
+            half k2 = luma(xy + r * float2(-2.598, 1.5));
+            half k3 = luma(xy + r * float2(-2.598, -1.5));
+            half k4 = luma(xy + r * float2(0.0, -3.0));
+            half k5 = luma(xy + r * float2(2.598, -1.5));
+            half o = other(a0, mid, dark) + other(a1, mid, dark) + other(a2, mid, dark) +
+                       other(a3, mid, dark) + other(a4, mid, dark) + other(a5, mid, dark) +
+                       other(b0, mid, dark) + other(b1, mid, dark) + other(b2, mid, dark) +
+                       other(b3, mid, dark) + other(b4, mid, dark) + other(b5, mid, dark) +
+                       other(k0, mid, dark) + other(k1, mid, dark) + other(k2, mid, dark) +
+                       other(k3, mid, dark) + other(k4, mid, dark) + other(k5, mid, dark);
+            push = smoothstep(m0, m1, o / 18.0) * smoothstep(ms * 0.6, ms, spread) * gate *
+                    strength;
+            y = mix(y, dark ? 0.0 : 1.0, push);
+        }
+        bool line = false;
+        bool knocked = false;
+        if (dark) {
+            bool wantContour = spread >= c0 && spread < cmax && hi >= clight;
+            // gate > 0.5 keeps knockout off high-contrast edges inside photos
+            bool wantKnock = knock > 0.5 && push < 0.5 && spread >= ms && gate > 0.5;
+            if (wantContour || wantKnock) {
+                half n4 = max(max(luma(xy + float2(1.0, 0.0)), luma(xy - float2(1.0, 0.0))),
+                              max(luma(xy + float2(0.0, 1.0)), luma(xy - float2(0.0, 1.0))));
+                if (n4 >= mid) {
+                    // low-contrast steps between light flat tones: a 1-px line on the darker
+                    // side (dotted below csolid)
+                    if (wantContour) {
+                        float2 ip = floor(xy);
+                        line = spread >= csolid || mod(ip.x + ip.y, 2.0) < 0.5;
+                    }
+                    // a dithered fill pixel touching a light label: clear 1-px margin
+                    knocked = wantKnock;
+                }
+            }
+        }
+        half t = line ? 0.0 : tone(y);
+        if (knocked && t > 0.0 && t < 1.0) {
+            t = 1.0;
+        }
+        half v = t > th ? 1.0 : 0.0;
+        return half4(v, v, v, 1.0);
+    }
+)";
+
+static const char* const kEinkRenderFastSkSL = R"(
+    uniform shader img;
+    uniform shader noise;
+    uniform float bleach;
+    uniform float crush;
+    uniform float gamma;
+    uniform float invert;
+    const half3 W = half3(0.299, 0.587, 0.114);
+    half4 main(float2 xy) {
+        half y = dot(img.eval(xy).rgb, W);
+        if (invert > 0.5) y = 1.0 - y;
+        half th = (noise.eval(xy).r * 255.0 + 0.5) / 256.0;
+        half t = saturate((y - 0.04) / 0.92);
+        if (bleach < 1.0) {
+            t = mix(t, 1.0, smoothstep(bleach, bleach + 0.10, y));
+        }
+        if (crush > 0.0) {
+            t *= smoothstep(crush * 0.6, crush, y);
+        }
+        t = t <= 0.0 ? 0.0 : pow(t, gamma);
+        half v = t > th ? 1.0 : 0.0;
+        return half4(v, v, v, 1.0);
+    }
+)";
+
+static const char* const kEinkRenderHdSkSL = R"(
+    uniform shader img;
+    uniform shader noise;
+    uniform float gamma16;
+    uniform float invert;
+    const half3 W = half3(0.299, 0.587, 0.114);
+    half4 main(float2 xy) {
+        half l = dot(img.eval(xy).rgb, W);
+        if (invert > 0.5) l = 1.0 - l;
+        half th = (noise.eval(xy).r * 255.0 + 0.5) / 256.0;
+        half t = saturate((l - 0.04) / 0.92);
+        t = t <= 0.0 ? 0.0 : pow(t, gamma16);
+        half q = clamp(floor(t * 15.0 + th), 0.0, 15.0);
+        half v = (q * 16.0 + 4.0) / 255.0;  // passes the kernel's 16-level dither unchanged
+        return half4(v, v, v, 1.0);
+    }
+)";
+
+void SkiaRenderEngine::drawEinkRender(const DisplaySettings& display,
+                                      const sk_sp<SkSurface>& surface, SkCanvas* canvas) {
+    SFTRACE_CALL();
+    static const sk_sp<SkRuntimeEffect> sEffectFull = [] {
+        auto [effect, error] = SkRuntimeEffect::MakeForShader(SkString(kEinkRenderSkSL));
+        if (!effect) ALOGE("e-ink render shader: %s", error.c_str());
+        return effect;
+    }();
+    static const sk_sp<SkRuntimeEffect> sEffectFast = [] {
+        auto [effect, error] = SkRuntimeEffect::MakeForShader(SkString(kEinkRenderFastSkSL));
+        if (!effect) ALOGE("e-ink fast shader: %s", error.c_str());
+        return effect;
+    }();
+    static const sk_sp<SkRuntimeEffect> sEffectHd = [] {
+        auto [effect, error] = SkRuntimeEffect::MakeForShader(SkString(kEinkRenderHdSkSL));
+        if (!effect) ALOGE("e-ink hd shader: %s", error.c_str());
+        return effect;
+    }();
+    static const sk_sp<SkImage> sNoise = [] {
+        const SkImageInfo info = SkImageInfo::Make(kEinkBlueNoiseSize, kEinkBlueNoiseSize,
+                                                   kGray_8_SkColorType, kOpaque_SkAlphaType);
+        return SkImages::RasterFromPixmapCopy(
+                SkPixmap(info, kEinkBlueNoise, static_cast<size_t>(kEinkBlueNoiseSize)));
+    }();
+    const sk_sp<SkRuntimeEffect>& effect = display.einkMode >= 2 ? sEffectHd
+            : display.einkMode == 1                              ? sEffectFast
+                                                                 : sEffectFull;
+    if (!effect || !sNoise) return;
+    sk_sp<SkImage> frame = surface->makeImageSnapshot();
+    if (!frame) return;
+    SkRuntimeShaderBuilder builder(effect);
+    builder.child("img") = frame->makeShader(SkTileMode::kClamp, SkTileMode::kClamp,
+                                             SkSamplingOptions(SkFilterMode::kNearest));
+    // a data texture: no colour conversion, no filtering
+    builder.child("noise") = sNoise->makeRawShader(SkTileMode::kRepeat, SkTileMode::kRepeat,
+                                                   SkSamplingOptions(SkFilterMode::kNearest));
+    builder.uniform("invert") = display.einkInvert ? 1.f : 0.f;
+    if (display.einkMode >= 2) {
+        builder.uniform("gamma16") = std::max(display.einkGamma16, 0.1f);
+    } else if (display.einkMode == 1) {
+        builder.uniform("bleach") = display.einkBleach;
+        builder.uniform("crush") = display.einkCrush;
+        builder.uniform("gamma") = std::max(display.einkGamma, 0.1f);
+    } else {
+        builder.uniform("r") = display.einkEnhanceRadius;
+        builder.uniform("t1") = display.einkEnhanceT1;
+        builder.uniform("t2") = std::max(display.einkEnhanceT2, display.einkEnhanceT1 + 0.001f);
+        builder.uniform("g0") = display.einkGate0;
+        builder.uniform("g1") = display.einkGate1 > 0.f
