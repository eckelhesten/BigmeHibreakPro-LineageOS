From 0000000000000000000000000000000000000015 Mon Sep 17 00:00:00 2001
From: hibreak <hibreak@localhost>
Date: Fri, 20 Nov 2026 23:40:00 +0100
Subject: [PATCH] sf: fix EinkMotion finger-hold/cursor bugs and CLEAN kernel
 dither mismatch

Fixes four issues in the e-ink motion and render pipeline:
- Holding a finger down (e.g. resting a thumb while reading) oscillated
  between FAST and NORMAL every 700 ms because threadLoop() did not check
  vendor.xrz.hibreak_touch before restoring mBase and calling repaint().
- Periodic 500 ms updates (Compose/WebView blinking cursors, spinners)
  reset mLastFrame unconditionally and trapped the panel in FAST + cheap
  scroll rendering indefinitely once the keyboard closed. Only motion
  cadence frames (<= gap_ms) or explicit fast triggers extend mMotionEnd.
- Track vendor.xrz.global_refresh_mode by property serial as well as value,
  unwind mAsleep if debug.sf.eink_sleep is disabled while asleep, avoid
  releasing a sleep hold without arming the one-shot when arm_ms >= min_ms,
  clear a stale sleep one-shot on fast wake with wake_mode=0, and avoid a
  redundant SetProperty when entering sleep from FAST.
- In Output.cpp, track the kernel's g_last_dither_type (3 after NORMAL/FAST,
  4 after HD) so CLEAN (0xb0) and GC16 (0x04) match the kernel's actual
  dither routine instead of feeding 0xf4 white into 1-bit Atkinson Y1
  (which flips newly white pixels to black), and skip reading legacy
  render=2 properties when render >= 3.
---
 .../CompositionEngine/src/Output.cpp          | 71 +++++++++++--------
 .../DisplayHardware/EinkMotion.cpp            | 66 ++++++++++++-----
 .../DisplayHardware/EinkMotion.h              |  5 ++
 3 files changed, 94 insertions(+), 48 deletions(-)

diff --git a/services/surfaceflinger/CompositionEngine/src/Output.cpp b/services/surfaceflinger/CompositionEngine/src/Output.cpp
index d1368b0..1111111 100644
--- a/services/surfaceflinger/CompositionEngine/src/Output.cpp
+++ b/services/surfaceflinger/CompositionEngine/src/Output.cpp
@@ -1561,48 +1561,40 @@ EinkEnhance getEinkEnhance() {
     static std::mutex sMutex;
     static uint32_t sSerial = 0xffffffffu;
     static EinkEnhance sConfig;
+    // Mirror the kernel's g_last_dither_type (docs/lessons-learned.md): 3 (1-bit Atkinson Y1)
+    // after NORMAL/FAST/HYPER, 4 (16-level Atkinson Y4) after HD/GL16. CLEAN/GC16 (0xb0/0x04)
+    // inherits g_last_dither_type when kernel dither is on.
+    static uint32_t sLastKernelDither = 3u;
     std::lock_guard lock(sMutex);
     const uint32_t serial = __system_property_area_serial();
     if (serial != sSerial) {
         sSerial = serial;
         EinkEnhance c;
         const uint32_t mode =
                 base::GetUintProperty<uint32_t>("vendor.xrz.global_refresh_mode", 0u) & 0xff;
-        const bool blackAndWhite = mode == 0 || mode == 0xb2 || mode == 0xb3 || mode == 0x02 ||
-                mode == 0x10 || mode == 0x11;
-        if (blackAndWhite) {
-            c.strength = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance", 0u) / 100.f;
-            // FAST (0xb3) is also the motion mode: debug.sf.eink_enhance.fast=0 leaves the pass
-            // out while the screen moves, for a shorter composition (the repaint in the normal
-            // mode at the end of the motion has it again).
-            if (mode == 0xb3 && !base::GetBoolProperty("debug.sf.eink_enhance.fast", true)) {
-                c.strength = 0.f;
-            }
-        }
+        const uint32_t forceMode =
+                base::GetUintProperty<uint32_t>("vendor.xrz.force_global_refresh_mode", 0u) & 0xff;
+        const bool commitDisabled =
+                base::GetBoolProperty("vendor.xrz.disable_commit", false);
+        const uint32_t enhancePct =
+                base::GetUintProperty<uint32_t>("debug.sf.eink_enhance", 0u);
         c.radius = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.radius_x10", 35u) / 10.f;
         c.t1 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.t1_x1000", 40u) / 1000.f;
         c.t2 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.t2_x1000", 120u) / 1000.f;
-        c.solid1 =
-                base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.solid1_x1000", 950u) / 1000.f;
-        c.solid2 =
-                base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.solid2_x1000", 1000u) / 1000.f;
         c.gate0 =
                 base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.gate0_x1000", 550u) / 1000.f;
         c.gate1 =
                 base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.gate1_x1000", 800u) / 1000.f;
-        c.black = std::min(120u, base::GetUintProperty<uint32_t>(
-                                         "vendor.xrz.hibreak_contrast_black", 0u)) / 255.f;
-        c.white = std::max(135u, std::min(255u, base::GetUintProperty<uint32_t>(
-                                                        "vendor.xrz.hibreak_contrast_white",
-                                                        255u))) / 255.f;
         c.render = static_cast<int32_t>(
                 base::GetUintProperty<uint32_t>("debug.sf.eink_render", 3u));
-        if (c.render >= 3 && base::GetUintProperty<uint32_t>("debug.sf.eink_enhance", 0u) > 0) {
+        const uint32_t effectiveMode = (forceMode != 0) ? forceMode : mode;
+        if (c.render >= 3 && enhancePct > 0) {
             // The panel's mode decides what the frame must become: NORMAL (DU, dithered by the
             // kernel) gets the full pass; FAST and HYPER (A2, never dithered by the kernel: greys
             // would become partial drives and grey residue) the cheap one; the grey modes
-            // (HD, CLEAN, GL16) 16 levels.
-            switch (mode) {
+            // (HD, GL16) 16 levels. CLEAN/GC16 (0xb0/0x04) inherits g_last_dither_type in the
+            // kernel when kernel dither is on, so match 1-bit (0/255) vs 16-level (16*q+4).
+            switch (effectiveMode) {
                 case 0xb3: case 0x10: case 0x11: case 0xb7:
                 {
                     // FAST is the scrolling mode and the typing mode (the whole time the keyboard
@@ -1618,15 +1610,20 @@ EinkEnhance getEinkEnhance() {
                     const bool ime = base::GetBoolProperty("vendor.xrz.hibreak_ime_visible", false);
                     c.mode = (full == 1 || (full == 2 && ime)) ? 0 : 1;
                     break;
                 }
-                case 0xb1: case 0x21: case 0xb0: case 0x04: case 0x20: case 0x84: case 0x40:
-                case 0xb4:
+                case 0xb1: case 0x21: case 0x20: case 0x84: case 0x40: case 0xb4:
                     c.mode = 2;
                     break;
+                case 0xb0: case 0x04:
+                    c.mode = (!base::GetBoolProperty("debug.sf.eink_kernel_dither", true) ||
+                              sLastKernelDither == 4u)
+                            ? 2
+                            : 0;
+                    break;
                 default:
                     c.mode = 0;
             }
-            c.strength = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance", 0u) / 100.f;
+            c.strength = enhancePct / 100.f;
             c.minority0 = einkProp("debug.sf.eink.minority0_x1000", 500u, 1000.f);
             c.minority1 = einkProp("debug.sf.eink.minority1_x1000", 650u, 1000.f);
             c.minSpread = einkProp("debug.sf.eink.minspread_x1000", 250u, 1000.f);
@@ -1655,7 +1652,35 @@ EinkEnhance getEinkEnhance() {
             c.white = 1.f;
         } else {
             c.render = 0;
+            const bool blackAndWhite = mode == 0 || mode == 0xb2 || mode == 0xb3 || mode == 0x02 ||
+                    mode == 0x10 || mode == 0x11;
+            if (blackAndWhite) {
+                c.strength = enhancePct / 100.f;
+                // FAST (0xb3) is also the motion mode: debug.sf.eink_enhance.fast=0 leaves the
+                // pass out while the screen moves, for a shorter composition (the repaint in the
+                // normal mode at the end of the motion has it again).
+                if (mode == 0xb3 && !base::GetBoolProperty("debug.sf.eink_enhance.fast", true)) {
+                    c.strength = 0.f;
+                }
+            }
+            c.solid1 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.solid1_x1000", 950u) /
+                    1000.f;
+            c.solid2 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.solid2_x1000",
+                                                       1000u) / 1000.f;
+            c.black = std::min(120u, base::GetUintProperty<uint32_t>(
+                                             "vendor.xrz.hibreak_contrast_black", 0u)) / 255.f;
+            c.white = std::max(135u, std::min(255u, base::GetUintProperty<uint32_t>(
+                                                            "vendor.xrz.hibreak_contrast_white",
+                                                            255u))) / 255.f;
         }
+        if (!commitDisabled) {
+            if (effectiveMode == 0xb1 || effectiveMode == 0x21 || effectiveMode == 0x20 ||
+                effectiveMode == 0x84 || effectiveMode == 0x40 || effectiveMode == 0xb4) {
+                sLastKernelDither = 4u;
+            } else if (effectiveMode != 0xb0 && effectiveMode != 0x04) {
+                sLastKernelDither = 3u;
+            }
+        }
         sConfig = c;
     }
     return sConfig;
diff --git a/services/surfaceflinger/DisplayHardware/EinkMotion.cpp b/services/surfaceflinger/DisplayHardware/EinkMotion.cpp
index 5762346..2222222 100644
--- a/services/surfaceflinger/DisplayHardware/EinkMotion.cpp
+++ b/services/surfaceflinger/DisplayHardware/EinkMotion.cpp
@@ -84,8 +84,9 @@ void EinkMotion::reloadConfigIfChanged() {
     c.ime = base::GetBoolProperty("vendor.xrz.hibreak_ime_fast", true);
     // The first frames of a flick after idle would otherwise go out in the normal mode, which
     // the kernel runs as a multi-pass update (~550 ms) that the FAST frames queue behind.
-    c.touchDown = c.motion && base::GetBoolProperty("debug.sf.eink_motion.touch", true) &&
-            base::GetBoolProperty("vendor.xrz.hibreak_touch", false);
+    c.touchEnabled = c.motion && base::GetBoolProperty("debug.sf.eink_motion.touch", true);
+    c.touchDown = c.touchEnabled &&
+            base::GetBoolProperty("vendor.xrz.hibreak_touch", false);
     c.fastMode = base::GetUintProperty<uint32_t>("debug.sf.eink_motion.mode", 0xb3);
     c.frames = std::max(2u, base::GetUintProperty<uint32_t>("debug.sf.eink_motion.frames", 3));
     c.gap = ms2ns(base::GetUintProperty<uint32_t>("debug.sf.eink_motion.gap_ms", 150));
@@ -119,8 +120,15 @@ uint32_t EinkMotion::readMode() {
     return mode == 0xffffffffu ? 0 : mode;
 }
 
+uint32_t EinkMotion::modeSerial() {
+    if (!mModeProp) mModeProp = __system_property_find(kModeProperty);
+    return mModeProp ? __system_property_serial(mModeProp) : 0u;
+}
+
 void EinkMotion::writeMode(uint32_t mode) {
     base::SetProperty(kModeProperty, std::to_string(mode));
+    if (!mModeProp) mModeProp = __system_property_find(kModeProperty);
+    mWrittenSerial = mModeProp ? __system_property_serial(mModeProp) : 0u;
 }
 
 bool EinkMotion::isFast(uint32_t mode) const {
@@ -132,17 +140,25 @@ void EinkMotion::beginSleepTransition(bool asleep, nsecs_t now) {
     mAsleep = asleep;
     const uint32_t current = readMode();
     if (asleep) {
         // The mode to come back to: the user's, not a fast mode of ours that is still set.
-        mSleepBase = (mFast && current == mWritten) ? mBase : current;
-        if (mFast && current == mWritten) writeMode(mBase);
+        const bool ours = mFast && current == mWritten && modeSerial() == mWrittenSerial;
+        mSleepBase = ours ? mBase : current;
+        if (ours && mConfig.sleepMode == 0) writeMode(mBase);
         mFast = false;
         mStreak = 0;
-        applySleepMode();
+        if (mConfig.sleepMode != 0 && current != mConfig.sleepMode) {
+            mSleepWritten = mConfig.sleepMode;
+            writeMode(mSleepWritten);
+            mSleepModeSet = (mSleepBase != mConfig.sleepMode);
+        }
     } else if (mSleepModeSet) {
         // Unless someone else changed the mode meanwhile.
         if (current == mSleepWritten) writeMode(mSleepBase);
         mSleepModeSet = false;
     }
+    if (!asleep && mForceArmed && mConfig.wakeMode == 0) {
+        base::SetProperty(kForceModeProperty, "0");
+    }
     base::SetProperty(kDisableCommitProperty, "1");
     mForceArmed = false;
     mFrozen = true;
@@ -169,8 +185,18 @@ void EinkMotion::onComposite(bool imeVisible) {
     std::lock_guard lock(mMutex);
     reloadConfigIfChanged();
     const nsecs_t now = systemTime();
+    if (!mConfig.sleep && mAsleep) {
+        if (mFrozen) {
+            base::SetProperty(kDisableCommitProperty, "0");
+            mFrozen = false;
+        }
+        if (mSleepModeSet && readMode() == mSleepWritten) writeMode(mSleepBase);
+        mSleepModeSet = false;
+        mAsleep = false;
+    }
     if (mConfig.sleep && mConfig.asleep != mAsleep) beginSleepTransition(mConfig.asleep, now);
-    mStreak = (mLastFrame != 0 && now - mLastFrame <= mConfig.gap) ? mStreak + 1 : 1;
+    const bool inCadence = mLastFrame != 0 && now - mLastFrame <= mConfig.gap;
+    mStreak = inCadence ? mStreak + 1 : 1;
     mLastFrame = now;
     mImeVisible = imeVisible;
     if (imeVisible != mImePublished) {
@@ -194,7 +220,10 @@ void EinkMotion::onComposite(bool imeVisible) {
     const bool wantFast = (mConfig.motion && mStreak >= mConfig.frames) || mConfig.touchDown ||
             (mConfig.ime && imeVisible);
     const uint32_t current = readMode();
-    if (mFast && current != mWritten) {
+    if (wantFast || (mFast && inCadence)) {
+        mMotionEnd = now;
+    }
+    if (mFast && (current != mWritten || modeSerial() != mWrittenSerial)) {
         // Someone else changed the mode meanwhile (e.g. another app came to the front): that is
         // the mode to go back to.
         mBase = current;
@@ -206,6 +235,7 @@ void EinkMotion::onComposite(bool imeVisible) {
         mWritten = mConfig.fastMode;
         writeMode(mWritten);
         mFast = true;
+        mMotionEnd = now;
     }
     // The thread ends the fast mode once the frames stop.
     if (mFast) mCondition.notify_one();
@@ -234,7 +264,12 @@ void EinkMotion::threadLoop() {
             if (now < due) {
                 mCondition.wait_for(lock, std::chrono::nanoseconds(due - now));
                 continue;
             }
+            if (!mForceArmed) {
+                const uint32_t show = mFreezeForSleep ? mConfig.sleepClean : mConfig.wakeMode;
+                if (show != 0) base::SetProperty(kForceModeProperty, std::to_string(show));
+                mForceArmed = true;
+            }
             // The screen has settled: show it in one update.
             base::SetProperty(kDisableCommitProperty, "0");
             ALOGI("%s: panel released after %d ms", mFreezeForSleep ? "asleep" : "awake",
@@ -250,7 +285,7 @@ void EinkMotion::threadLoop() {
             continue;
         }
         const nsecs_t now = systemTime();
-        const nsecs_t due = mLastFrame + mConfig.end;
+        const nsecs_t due = mMotionEnd + mConfig.end;
         const bool held = mConfig.ime && mImeVisible;
         if (held) {
             // The keyboard is up; onComposite wakes us when that changes.
@@ -261,8 +296,14 @@ void EinkMotion::threadLoop() {
             mCondition.wait_for(lock, std::chrono::nanoseconds(due - now));
             continue;
         }
+        // Keep FAST while a finger is still resting on the screen so the settle repaint does not
+        // immediately re-enter FAST and oscillate every 700 ms.
+        if (mConfig.touchEnabled && base::GetBoolProperty("vendor.xrz.hibreak_touch", false)) {
+            mCondition.wait_for(lock, std::chrono::milliseconds(100));
+            continue;
+        }
         // The screen is still: back to the user's mode, and one repaint in it.
-        if (readMode() == mWritten) writeMode(mBase);
+        if (readMode() == mWritten && modeSerial() == mWrittenSerial) writeMode(mBase);
         mFast = false;
         mStreak = 0;
         mLastFrame = 0; // the repaint must not count as motion
diff --git a/services/surfaceflinger/DisplayHardware/EinkMotion.h b/services/surfaceflinger/DisplayHardware/EinkMotion.h
index 78473df..3333333 100644
--- a/services/surfaceflinger/DisplayHardware/EinkMotion.h
+++ b/services/surfaceflinger/DisplayHardware/EinkMotion.h
@@ -63,6 +63,7 @@ private:
         bool ime = true;         // vendor.xrz.hibreak_ime_fast
         // A finger is on the screen (vendor.xrz.hibreak_touch, set by system_server), and
         // frames composed meanwhile go FAST at once (debug.sf.eink_motion.touch, default on).
+        bool touchEnabled = true;
         bool touchDown = false;
         uint32_t fastMode = 0xb3; // debug.sf.eink_motion.mode
         uint32_t frames = 3;     // debug.sf.eink_motion.frames
@@ -85,6 +86,7 @@ private:
 
     void reloadConfigIfChanged();
     uint32_t readMode();
+    uint32_t modeSerial();
     void writeMode(uint32_t mode);
     bool isFast(uint32_t mode) const;
     void threadLoop();
@@ -99,12 +101,15 @@ private:
     const prop_info* mModeProp = nullptr;
 
     nsecs_t mLastFrame = 0;
+    // Last timestamp that extends the FAST exit countdown (not reset by slow 500 ms cursor blinks).
+    nsecs_t mMotionEnd = 0;
     uint32_t mStreak = 0;
     bool mImeVisible = false;
     bool mImePublished = false;
     bool mFast = false;    // the property holds our fast mode
     uint32_t mBase = 0;    // the mode to put back
     uint32_t mWritten = 0; // what we wrote, to notice when someone else changes the mode
+    uint32_t mWrittenSerial = 0;
 
     bool mAsleep = false;         // the last vendor.xrz.hibreak_sleep acted on
     bool mFrozen = false;         // the composer's panel updates are held back
-- 
