     void drawShadow(SkCanvas* canvas, const SkRRect& casterRRect,
                     const ShadowSettings& shadowSettings);
-    void drawEinkEnhance(const DisplaySettings& display, const sk_sp<SkSurface>& surface,
+    // Both draw the pass over the whole canvas from `frame`, the composed picture; false when
+    // nothing was drawn (the effect failed to compile).
+    bool drawEinkEnhance(const DisplaySettings& display, const sk_sp<SkImage>& frame,
                          SkCanvas* canvas);
-    void drawEinkRender(const DisplaySettings& display, const sk_sp<SkSurface>& surface,
+    bool drawEinkRender(const DisplaySettings& display, const sk_sp<SkImage>& frame,
                         SkCanvas* canvas);
     void drawLayersInternal(const std::shared_ptr<std::promise<FenceResult>>&& resultPromise,
                             const DisplaySettings& display,
diff --git a/services/surfaceflinger/CompositionEngine/src/Output.cpp b/services/surfaceflinger/CompositionEngine/src/Output.cpp
index e1b2107..d332f8d 100644
--- a/services/surfaceflinger/CompositionEngine/src/Output.cpp
