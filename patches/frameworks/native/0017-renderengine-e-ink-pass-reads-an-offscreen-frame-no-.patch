 };
 
 float einkProp(const char* name, uint32_t def, float scale) {
@@ -1609,6 +1611,7 @@ EinkEnhance getEinkEnhance() {
         c.render = static_cast<int32_t>(
                 base::GetUintProperty<uint32_t>("debug.sf.eink_render", 3u));
         c.damagePad = base::GetBoolProperty("debug.sf.eink.damage_pad", true);
+        c.offscreen = base::GetBoolProperty("debug.sf.eink.offscreen", true);
         const uint32_t effectiveMode = (forceMode != 0) ? forceMode : mode;
         if (c.render >= 3 && enhancePct > 0) {
             // The panel's mode decides what the frame must become: NORMAL (DU, dithered by the
@@ -1794,6 +1797,7 @@ void Output::applyEinkEnhance(renderengine::DisplaySettings& settings) {
     settings.einkMinTone = eink.minTone;
     settings.einkKnock = eink.knock;
     settings.einkInvert = eink.invert;
+    settings.einkOffscreen = eink.offscreen;
 }
 
 std::vector<LayerFE::LayerSettings> Output::generateClientCompositionRequests(
