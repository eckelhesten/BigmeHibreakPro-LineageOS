+#pragma once
+
+#include <android-base/parsebool.h>
+#include <android-base/parseint.h>
+#include <sys/system_properties.h>
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace android::compositionengine::impl {
+
+// E-ink (Bigme HiBreak Pro): SurfaceFlinger's e-ink code (EinkMotion, the render pass settings in
+// Output) caches its tuning properties and reads them again when a property changed. The area
+// serial (__system_property_area_serial) changes with every write anywhere, and a few properties
+// are written all the time: by system_server (a finger down and up, sleep, unlock, the fingerprint
+// sensor) and by SurfaceFlinger itself (the refresh mode, the one-shot, the panel holds). Each of
+// those writes made both caches read ~60 properties on SurfaceFlinger's main thread.
+//
+// This tells those writes apart. Every update adds 1 to the area serial and 2 to the low 24 bits
+// of the property's own serial (bionic system_properties.cpp: odd while the value is being
+// written), and adding a property adds 1 to the area serial. So when the area serial grew by
+// exactly the number of updates of the listed properties, nothing else changed. Anything that
+// can't be accounted for (an added property, a write in progress, a missing property that
+// appeared) counts as a change: the caller reloads, as before. A write of another property that
+// races with a listed one is seen at the next call, when the area serial moves again.
+//
+// The listed properties are the caller's to read on every call, through info(). Not thread-safe.
+template <size_t N>
+class EinkPropertyWatch {
+public:
+    explicit EinkPropertyWatch(const std::array<const char*, N>& names) : mNames(names) {}
+
+    // True on the first call, and when a property other than the listed ones was written or
+    // added since the last call.
+    bool othersChanged() {
+        const uint32_t area = __system_property_area_serial();
+        if (mKnown && area == mArea) return false;
+        bool others = !mKnown;
+        uint32_t updates = 0;
+        for (size_t i = 0; i < N; i++) {
+            if (mInfo[i] == nullptr) {
+                // Properties only appear with an area change: look again now.
+                mInfo[i] = __system_property_find(mNames[i]);
+                if (mInfo[i] != nullptr) {
+                    mCount[i] = updateCount(mInfo[i]);
+                    others = true; // added: its updates so far are not counted
+                }
+                continue;
+            }
+            const uint32_t count = updateCount(mInfo[i]);
+            updates += (count - mCount[i]) & kCountMask;
+            mCount[i] = count;
+        }
+        if (area - mArea != updates) others = true;
+        mArea = area;
+        mKnown = true;
+        return others;
+    }
+
+    // The listed property's prop_info, or null while it doesn't exist (found again at the next
+    // area change).
+    const prop_info* info(size_t i) const { return mInfo[i]; }
+
+private:
+    static constexpr uint32_t kCountMask = 0x7fffff;
+
+    // A property's updates so far (mod 2^23). A write in progress (odd serial) is not done yet.
+    static uint32_t updateCount(const prop_info* pi) {
+        return (__system_property_serial(pi) & 0xffffff) >> 1;
+    }
+
+    const std::array<const char*, N> mNames;
+    std::array<const prop_info*, N> mInfo{};
+    std::array<uint32_t, N> mCount{};
+    uint32_t mArea = 0;
+    bool mKnown = false;
+};
+
+namespace eink_detail {
+inline void copyValue(void* cookie, const char*, const char* value, uint32_t) {
+    *static_cast<std::string*>(cookie) = value;
+}
+} // namespace eink_detail
+
+// A property's value from its prop_info, parsed as base::GetBoolProperty / GetUintProperty do:
+// the default when it doesn't exist, is empty or doesn't parse.
+inline std::string einkPropValue(const prop_info* pi) {
+    std::string value;
+    if (pi != nullptr) __system_property_read_callback(pi, eink_detail::copyValue, &value);
+    return value;
+}
+
+inline bool einkPropBool(const prop_info* pi, bool defaultValue) {
+    switch (base::ParseBool(einkPropValue(pi))) {
+        case base::ParseBoolResult::kTrue:
+            return true;
+        case base::ParseBoolResult::kFalse:
+            return false;
+        default:
+            return defaultValue;
+    }
+}
+
+template <typename T>
+T einkPropUint(const prop_info* pi, T defaultValue) {
+    const std::string value = einkPropValue(pi);
+    T result;
+    if (!value.empty() && base::ParseUint(value, &result)) return result;
+    return defaultValue;
+}
+
+} // namespace android::compositionengine::impl
