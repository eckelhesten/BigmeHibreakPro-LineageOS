+    t.gate0 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.gate0_x1000", 550u) / 1000.f;
+    t.gate1 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.gate1_x1000", 800u) / 1000.f;
+    t.render = static_cast<int32_t>(base::GetUintProperty<uint32_t>("debug.sf.eink_render", 3u));
+    t.damagePad = base::GetBoolProperty("debug.sf.eink.damage_pad", true);
+    t.offscreen = base::GetBoolProperty("debug.sf.eink.offscreen", true);
+    t.kernelDither = base::GetBoolProperty("debug.sf.eink_kernel_dither", true);
+    t.fastFull = base::GetUintProperty<uint32_t>("debug.sf.eink.fast_full", 2u);
+    t.fastGreys = base::GetUintProperty<uint32_t>(
+            "debug.sf.eink.fast_greys",
+            base::GetUintProperty<uint32_t>("vendor.xrz.hibreak_fast_greys", 0u));
+    t.minority0 = einkProp("debug.sf.eink.minority0_x1000", 500u, 1000.f);
+    t.minority1 = einkProp("debug.sf.eink.minority1_x1000", 650u, 1000.f);
+    t.minSpread = einkProp("debug.sf.eink.minspread_x1000", 250u, 1000.f);
+    const bool contourOn = base::GetBoolProperty("debug.sf.eink.contour", true);
+    t.contour0 = contourOn ? einkProp("debug.sf.eink.contour0_x1000", 30u, 1000.f) : 2.f;
+    t.contourMax = einkProp("debug.sf.eink.contourmax_x1000", 320u, 1000.f);
+    t.contourLight = einkProp("debug.sf.eink.contourlight_x1000", 750u, 1000.f);
+    t.contourSolid = einkProp("debug.sf.eink.contoursolid_x1000", 100u, 1000.f);
+    t.contour16 = (contourOn && base::GetBoolProperty("debug.sf.eink.contour16", true))
+            ? std::max(0.f,
+                       std::min(1.f, einkProp("debug.sf.eink.contour16_drop_x1000", 300u, 1000.f)))
+            : 0.f;
+    t.gamma = einkProp("debug.sf.eink.gamma_x100", 125u, 100.f);
+    t.gamma16 = einkProp("debug.sf.eink.gamma16_x100", 125u, 100.f);
+    // Upper white point of the 16-level pass: 1.0 keeps light UI surfaces (#F5F5F5,
+    // #EFEAE2, #D9FDD3) distinct from white instead of clipping >= 0.96 to white.
+    t.white16 =
+            std::max(0.5f, std::min(1.f, einkProp("debug.sf.eink.white16_x1000", 1000u, 1000.f)));
+    // Greys in FAST, measured per temperature band: HiBreakParts publishes the band's curve and
