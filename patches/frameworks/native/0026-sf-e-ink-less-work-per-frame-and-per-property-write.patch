+    // of the two the kernel picks its waveform by. The debug properties override them for the
+    // bench.
+    t.gammaFast = einkProp("debug.sf.eink.gamma_fast_x100",
+                           base::GetUintProperty<uint32_t>("vendor.xrz.hibreak_fast_gamma_x100",
+                                                           200u),
+                           100.f);
+    t.levelMapFast = einkLevelMap(base::GetProperty("debug.sf.eink.fast_levels", "").empty()
+                                          ? "vendor.xrz.hibreak_fast_levels"
+                                          : "debug.sf.eink.fast_levels");
+    t.minTone = einkProp("debug.sf.eink.mintone_x1000", 1000u, 1000.f);
+    t.knock = base::GetBoolProperty("debug.sf.eink.knock", true);
+    // HiBreakParts' per-app "inverted" mode, set while such an app is in front
+    t.invert = base::GetBoolProperty("vendor.xrz.hibreak_eink_invert", false);
+    // HiBreakParts' contrast for this pass: light greys from `bleach` up become white
+    // (keeping an outline), greys below `crush` black; 255 / 0 turn them off. The
+    // enhancement pass keeps its own vendor.xrz.hibreak_contrast_black/white, so
+    // debug.sf.eink_render=2 still shows exactly what it did.
+    t.bleach = std::max(128u, std::min(255u, base::GetUintProperty<uint32_t>(
+                                                     "vendor.xrz.hibreak_eink_bleach", 194u))) /
+            255.f;
+    t.crush = std::min(128u, base::GetUintProperty<uint32_t>("vendor.xrz.hibreak_eink_crush", 92u)) /
+            255.f;
+    // FAST (0xb3) is also the motion mode: debug.sf.eink_enhance.fast=0 leaves the
+    // pass out while the screen moves, for a shorter composition (the repaint in the
+    // normal mode at the end of the motion has it again).
+    t.enhanceFast = base::GetBoolProperty("debug.sf.eink_enhance.fast", true);
+    t.solid1 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.solid1_x1000", 950u) / 1000.f;
+    t.solid2 = base::GetUintProperty<uint32_t>("debug.sf.eink_enhance.solid2_x1000", 1000u) / 1000.f;
+    t.contrastBlack =
+            std::min(120u, base::GetUintProperty<uint32_t>("vendor.xrz.hibreak_contrast_black", 0u)) /
+            255.f;
+    t.contrastWhite = std::max(135u, std::min(255u, base::GetUintProperty<uint32_t>(
+                                                            "vendor.xrz.hibreak_contrast_white",
+                                                            255u))) /
+            255.f;
+    return t;
+}
