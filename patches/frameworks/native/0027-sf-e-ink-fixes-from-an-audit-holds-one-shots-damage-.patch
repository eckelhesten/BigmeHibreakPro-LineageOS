             }
@@ -450,7 +474,8 @@ void EinkMotion::onComposite(bool imeVisible, float damage, bool barsVisible) {
     uint32_t current = readMode();
     // Occasional frames under a resting finger (a cursor blink) don't extend the fast mode;
