     mFreezeForTurn = false;
     mFreezeForSleep = false;
@@ -323,11 +336,13 @@ void EinkMotion::beginUnlockHold(nsecs_t now) {
     mCondition.notify_one();
 }
 
-bool EinkMotion::fingerReading(nsecs_t now) {
+bool EinkMotion::fingerReading() {
     // Read here, not from mConfig: the thread waits without composites coming in.
     if (!mFingerProp) mFingerProp = __system_property_find(kFingerProperty);
     const uint64_t at = einkPropUint<uint64_t>(mFingerProp, 0);
-    const uint64_t nowMs = static_cast<uint64_t>(ns2ms(now));
+    // The time after the read: an acquire written while the thread was writing a property (an
+    // IPC of a few ms) is newer than the thread's own `now`, and would not count.
+    const uint64_t nowMs = static_cast<uint64_t>(ns2ms(systemTime()));
     return at != 0 && at <= nowMs && nowMs - at < static_cast<uint64_t>(ns2ms(mConfig.fingerWindow));
 }
 
@@ -355,6 +370,13 @@ void EinkMotion::onComposite(bool imeVisible, float damage, bool barsVisible) {
