+package com.android.internal.telephony.metrics;
+
+/**
+ * No-op stand-in for the legacy telephony metrics logger that Android 16 removed.
+ *
+ * Prebuilt vendor ImsService packages built for Android 14 (MediaTek's com.mediatek.ims) call
+ * these methods from their RIL adapter on every IMS request and response. Without the class they
+ * die with NoClassDefFoundError on the first one. Nothing here records anything.
+ *
+ * @hide
+ */
+public class TelephonyMetrics {
+    private static final TelephonyMetrics sInstance = new TelephonyMetrics();
+
+    private TelephonyMetrics() {}
+
+    /** @return the shared no-op instance */
+    public static TelephonyMetrics getInstance() {
+        return sInstance;
+    }
+
+    /** Solicited RIL response (no-op). */
+    public void writeOnRilSolicitedResponse(int phoneId, int rilSerial, int rilError, int rilRequest,
+            Object ret) {}
+
+    /** RIL request timeout (no-op). */
+    public void writeOnRilTimeoutResponse(int phoneId, int rilSerial, int rilRequest) {}
+
+    /** RIL answer request (no-op). */
+    public void writeRilAnswer(int phoneId, int rilSerial) {}
+
+    /** SMS sent through the RIL (no-op). */
+    public void writeRilSendSms(int phoneId, int rilSerial, int tech, int format, long messageId) {}
+
+    /** SMS sent through the RIL, Android 10 and older signature (no-op). */
+    public void writeRilSendSms(int phoneId, int rilSerial, int tech, int format) {}
+}
