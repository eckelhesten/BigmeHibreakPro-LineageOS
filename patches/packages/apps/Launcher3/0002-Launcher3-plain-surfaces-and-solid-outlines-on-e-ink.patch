+ * limitations under the License.
+ */
+
+package com.android.launcher3.util
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.drawable.GradientDrawable
+import android.util.Log
+import android.util.TypedValue
+import android.view.View
+
+/**
+ * The launcher's look on e-ink panels (debug.sysui.eink_palette=1, the property SystemUI uses for
+ * its two-tone palette). Such a panel shows greys and translucent scrims as dithered noise, so
+ * surfaces are plain paper (white, or black in dark mode) and their edges are solid ink lines.
+ */
+object EinkUi {
+
+    private const val OUTLINE_DP = 2f
+
+    @JvmField
+    val ENABLED: Boolean =
+        try {
+            // SystemProperties is not in the SDK that the non-quickstep launcher builds against.
+            Class.forName("android.os.SystemProperties")
+                .getMethod("getBoolean", String::class.java, Boolean::class.javaPrimitiveType)
+                .invoke(null, "debug.sysui.eink_palette", false) as Boolean
+        } catch (e: Exception) {
+            Log.w("EinkUi", "Unable to read the e-ink property", e)
+            false
+        }
+
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE }
+
+    private fun isNight(context: Context) = context.resources.configuration.isNightModeActive
+
+    /** The colour of plain surfaces. */
+    @JvmStatic fun paperColor(context: Context) = if (isNight(context)) Color.BLACK else Color.WHITE
+
+    /** The colour of text and outlines. */
+    @JvmStatic fun inkColor(context: Context) = if (isNight(context)) Color.WHITE else Color.BLACK
+
+    /** The outline width in pixels. */
+    @JvmStatic
+    fun outlineWidth(context: Context) =
+        TypedValue.applyDimension(
+            TypedValue.COMPLEX_UNIT_DIP,
+            OUTLINE_DP,
+            context.resources.displayMetrics,
+        )
+
+    /** Gives a shape drawable a solid outline. Other drawables are left as they are. */
+    @JvmStatic
+    fun outline(view: View) {
+        val background = view.background
+        if (background is GradientDrawable) {
+            (background.mutate() as GradientDrawable).setStroke(
+                Math.round(outlineWidth(view.context)),
+                inkColor(view.context),
+            )
+        }
+    }
+
+    /**
+     * Draws a solid outline just inside the given rounded rectangle. [scale] is the scale of the
+     * view the canvas belongs to, so the line keeps its width on screen. Main thread only.
+     */
+    @JvmStatic
+    fun drawOutline(
+        view: View,
+        canvas: Canvas,
+        left: Float,
+        top: Float,
+        right: Float,
+        bottom: Float,
+        radiusX: Float,
+        radiusY: Float,
+        scale: Float,
+    ) {
+        val width = outlineWidth(view.context) / (if (scale > 0f) scale else 1f)
+        val half = width / 2f
+        paint.strokeWidth = width
+        paint.color = inkColor(view.context)
+        canvas.drawRoundRect(
+            left + half,
+            top + half,
+            right - half,
+            bottom - half,
+            Math.max(radiusX - half, 0f),
+            Math.max(radiusY - half, 0f),
+            paint,
+        )
+    }
+}
diff --git a/src/com/android/launcher3/util/Themes.java b/src/com/android/launcher3/util/Themes.java
index 927a2a4..b45fb18 100644
--- a/src/com/android/launcher3/util/Themes.java
+++ b/src/com/android/launcher3/util/Themes.java
@@ -94,6 +94,18 @@ public class Themes {
     }
 
     public static int getAttrColor(Context context, int attr) {
+        if (EinkUi.ENABLED) {
+            // E-ink: the scrims behind recents and the app list are plain paper, not a
+            // translucent grey.
+            if (attr == R.attr.overviewScrimColor || attr == R.attr.allAppsScrimColor
+                    || attr == R.attr.allappsHeaderProtectionColor) {
+                return EinkUi.paperColor(context);
+            }
+            if (attr == R.attr.overviewScrimForegroundPrimary
+                    || attr == R.attr.overviewScrimForegroundSecondary) {
+                return Color.TRANSPARENT;
+            }
+        }
         return GraphicsUtils.getAttrColor(context, attr);
     }
 
