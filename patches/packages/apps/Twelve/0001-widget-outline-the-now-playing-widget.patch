From 547603acef4eda28da37e315feb6679e8391bc84 Mon Sep 17 00:00:00 2001
From: hibreak <build@localhost>
Date: Sun, 22 Nov 2026 00:30:29 +0000
Subject: [PATCH] widget: outline the now playing widget

The widget's surface and an e-ink home screen are both white, so the
widget had no visible edge. Draw the surface with a 1dp colorOnSurface
stroke (in the drawable itself: backgroundTint would tint the stroke too).

Change-Id: Ib8dd7f2842657e15ae6a2667f384f813da33737d
---
 .../main/res/drawable/bg_app_widget_outlined.xml | 16 ++++++++++++++++
 .../main/res/layout/app_widget_now_playing.xml   |  3 +--
 2 files changed, 17 insertions(+), 2 deletions(-)
 create mode 100644 app/src/main/res/drawable/bg_app_widget_outlined.xml

diff --git a/app/src/main/res/drawable/bg_app_widget_outlined.xml b/app/src/main/res/drawable/bg_app_widget_outlined.xml
new file mode 100644
index 0000000..44a0357
--- /dev/null
+++ b/app/src/main/res/drawable/bg_app_widget_outlined.xml
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: The LineageOS Project
+     SPDX-License-Identifier: Apache-2.0
+-->
+<!-- The widget's surface with a thin outline, so its edge shows on e-ink panels
+     where the surface and the wallpaper are both white. -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android"
+    android:shape="rectangle">
+
+    <corners android:radius="?attr/appWidgetRadius" />
+    <solid android:color="?attr/colorSurface" />
+    <stroke
+        android:width="1dp"
+        android:color="?attr/colorOnSurface" />
+</shape>
diff --git a/app/src/main/res/layout/app_widget_now_playing.xml b/app/src/main/res/layout/app_widget_now_playing.xml
index 775fea3..8e22b34 100644
--- a/app/src/main/res/layout/app_widget_now_playing.xml
+++ b/app/src/main/res/layout/app_widget_now_playing.xml
@@ -8,8 +8,7 @@
     android:id="@+id/linearLayout"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
-    android:background="@drawable/bg_app_widget"
-    android:backgroundTint="?attr/colorSurface"
+    android:background="@drawable/bg_app_widget_outlined"
     android:baselineAligned="false"
     android:clipToOutline="true"
     android:gravity="center_vertical"
-- 
2.43.0

